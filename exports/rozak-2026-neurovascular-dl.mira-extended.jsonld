      "@id": "urn:uuid:e05b0913-66d9-4ac2-be33-40385aaf6181",
      "@type": "mira:Evidence",
      "schema:name": "wt-controls-no-blue-green-difference",
      "schema:description": "Wild-type C57BL/6J mice (n=4) show no statistically distinguishable capillary radius distributions following blue (458 nm) versus green (552 nm) photostimulation, confirming that vascular responses in Thy1-ChR2 mice are ChR2-specific and not attributable to photothermal or non-specific light effects.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
