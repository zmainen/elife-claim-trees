    {
      "@id": "urn:uuid:8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e",
      "@type": "mira:Claim",
      "schema:name": "synthesis-individual-vessel-measurements-insufficient",
      "schema:description": "Interrogating individual vessels in isolation is insufficient to predict how blood flow is modulated across the cerebral microvascular network. The paper's combined evidence — within-vessel radius heterogeneity (24 ± 28% along vessel length at baseline), the spatial segregation of dilations and constrictions relative to active neurons, the network-wide rise in assortativity during optogenetic stimulation, and the modulation of capillary network efficiency — together argue that point-caliber and single-vessel approaches systematically miss the coordinated, graph-level structure of functional hyperemia.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.95525"
      },
      "haak:role": "synthesis",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:9a1c4f3e-5d2b-4f8a-8c71-1e6f2b9d0a77"
          }
        ]
      },
      "haak:verification": [
        {
          "@type": "haak:VerificationRecord",
          "haak:agent": "mainen-z",
          "schema:date": "2026-04-20",
          "haak:status": "N/A",
          "haak:executed": false
        }
      ],
      "haak:panel": "synthesis (Discussion)"
    },
    {
      "@id": "urn:uuid:db0a9448-8fe8-4336-b220-0a71aa19d870",
      "@type": "mira:Evidence",
      "schema:name": "unetr-outperforms-ilastik-hd95",
      "schema:description": "UNETR ensemble segmentation shows significantly better HD95 surface distance than ilastik for both vessel and neuron channels (p<0.05 Wilcoxon signed-rank), while ilastik over-segments vessels with high recall (0.89±0.19) but low precision (0.37±0.33), evaluated on nine test images (507×507×250 µm) from six held-out mice.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.95525"
      },
