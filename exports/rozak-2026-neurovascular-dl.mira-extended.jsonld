      "@type": "mira:Evidence",
      "schema:name": "network-assortativity-increases-stimulation",
      "schema:description": "Vascular network assortativity increases by 152 ± 65% at 4.3 mW/mm² optogenetic stimulation relative to control, indicating that high-degree vessels preferentially couple with high-degree vessels during neurovascular responses.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
