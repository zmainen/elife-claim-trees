    {
      "@id": "urn:uuid:be5c4a30-84bd-4867-9990-124635635526",
      "@type": "mira:Evidence",
      "title": "arcuate-body-four-sublayer-differential",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The arcuate body of Uloborus diversus is organized into four distinguishable sublayers — posterior and anterior subdivisions of each of the ventral (ABv) and dorsal (ABd) lobes — and individual neurotransmitter populations (5-HT, TDC2, ChAT, GABA, proctolin, CCAP, FMRFamide, AstA, dopamine) each innervate distinct subsets of these sublayers with non-uniform patterns, enabling discrimination of layer identity that synapsin staining alone cannot achieve."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.107732",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://doi.org/10.35077/ace-owl-gum"
      },
      "cgx:epistemicStatus": "mira:Claim",
      "cg:role": "empirical",
      "cg:epistemicStrength": "strong",
      "cg:relations": {
        "dissociates-with": [
          {
            "@id": "urn:uuid:42987256-31b8-4f7d-b81f-8f6976a904f0"
          },
          {
            "@id": "urn:uuid:6060326d-de93-44c9-a073-379eb2cefb75"
          }
        ],
        "extends": [
          {
            "@id": "urn:uuid:eb91b6b6-92c0-483d-8f88-d75708ac94c6"
          }
        ],
        "supports": [
          {
            "@id": "urn:uuid:eb91b6b6-92c0-483d-8f88-d75708ac94c6"
          }
        ]
      },
