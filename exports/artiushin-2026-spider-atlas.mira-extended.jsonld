    {
      "@id": "urn:uuid:42987256-31b8-4f7d-b81f-8f6976a904f0",
      "@type": "mira:Evidence",
      "title": "protocerebral-bridge-layered-transmitter-architecture",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The protocerebral bridge (PCB) of Uloborus diversus displays a layered neurotransmitter architecture: GABAergic (anti-GAD) immunoreactivity defines a nearly complete swath of the neuropil; TDC2 (octopaminergic/tyraminergic) fills heavy chains of puncta along the posterior edge; proctolin forms a tight thin band primarily at the medial end; and ChAT (cholinergic) immunoreactivity forms a distinct thin layer on both the anterior and posterior edges, most clearly on the lateral portion."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.107732",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://doi.org/10.35077/ace-owl-gum"
      },
      "cgx:epistemicStatus": "mira:Claim",
      "cg:role": "empirical",
