    {
      "@id": "urn:uuid:d4e4b107-1540-4bf3-b4af-4dca938e0d06",
      "@type": "mira:Claim",
      "schema:name": "atlas-observational-scope",
      "schema:description": "All primary claims in this paper are observational anatomical facts about the presence and distribution of neurotransmitters in identified neuropils; none are statistical in the conventional sense — the evidence is the 3D atlas itself, and reproduction means re-registering the same volumes or inspecting the deposited atlas, not re-computing statistics.",
