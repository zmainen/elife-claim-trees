    {
      "@id": "urn:uuid:a7565a82-5c41-40d9-a3d3-5e9194904515",
      "@type": "mira:Evidence",
      "schema:name": "opisthosomal-neuropil-tdc2-perimeter-ladder",
      "schema:description": "In the opisthosomal neuropil of Uloborus diversus, TDC2 (octopaminergic/tyraminergic) immunoreactivity forms an intricate patterned architecture: triangular puncta formations at the anterior ventral end connect to a continuous perimeter tract along the neuropil boundary, while longitudinal and lateral projections form a ladder-like structure in more posterior and dorsal planes, a pattern also partially revealed by proctolin and dopaminergic (TH) innervation.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.107732"
      },
