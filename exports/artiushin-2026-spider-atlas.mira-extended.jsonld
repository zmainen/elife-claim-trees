    {
      "@id": "urn:uuid:01384854-d4e5-4e8c-bf0b-239409c22675",
      "@type": "mira:Evidence",
      "schema:name": "globuli-cells-cholinergic-gabaergic",
      "schema:description": "The globuli cell cluster at the mushroom body heads of Uloborus diversus is revealed by ChAT immunoreactivity and to a lesser extent by GAD immunoreactivity, indicating that the globuli cells represent cholinergic and GABAergic populations; this is consistent with prior demonstration of ChAT-positive globuli cells in C. salei.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.107732"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.35077/ace-owl-gum",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "immunofluorescence, anti-ChAT / anti-GAD, confocal atlas"
        }
      },
