    {
      "@id": "urn:uuid:b7856315-9b56-4c97-97c7-4f3e2e2a785d",
      "@type": "mira:Evidence",
      "title": "leg-neuropils-consistent-innervation",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The four pairs of leg neuropils (LN1-LN4) display consistent innervation patterns across legs for the neurotransmitters mapped, indicating stereotyped neurochemical organization of the locomotor system."
      },
      "observationBase": {
        "@id": "https://doi.org/10.35077/ace-owl-gum"
