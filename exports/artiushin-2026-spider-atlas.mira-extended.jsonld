    {
      "@id": "urn:uuid:9cfe689f-623e-43b7-bd49-f7075865ae4c",
      "@type": "mira:Evidence",
      "title": "cheliceral-neuropil-serotonin-tdc2-dominant",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The cheliceral neuropil of Uloborus diversus is most abundantly innervated by serotonergic (anti-5-HT, fine varicosities filling the neuropil) and octopaminergic/tyraminergic (anti-TDC2, large puncta throughout) immunoreactivity; both populations also show pronounced signal in a region immediately medial to the cheliceral neuropil, where allatostatin A (AstA) additionally shows strong immunoreactivity."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.107732",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://doi.org/10.35077/ace-owl-gum"
      },
      "cgx:epistemicStatus": "mira:Claim",
      "cg:role": "empirical",
      "cg:epistemicStrength": "strong",
      "cg:relations": {
        "dissociates-with": [
          {
            "@id": "urn:uuid:0f8cb9fa-41a6-4a5d-8634-d8b670609fe8"
          },
          {
            "@id": "urn:uuid:b7856315-9b56-4c97-97c7-4f3e2e2a785d"
          }
        ]
      },
      "cg:verification": [
        {
