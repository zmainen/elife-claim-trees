    {
      "@id": "urn:uuid:a527b1e4-3c93-4579-9e3f-4e079a34a78f",
      "@type": "mira:Evidence",
      "schema:name": "leg-neuropil-serotonin-bilateral-innervation",
      "schema:description": "Serotonergic (5-HT) innervation in the leg neuropils of Uloborus diversus fills the neuropil in two roughly equal halves, with immunoreactivity supplied from the medial branch of the dorsal-most tract and leaving a central void, a pattern distinct from the uniform mesh-like dopaminergic innervation and the anterior/posterior differential of TDC2 signal in the same structures.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.107732"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.35077/ace-owl-gum",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "immunofluorescence, anti-5-HT, confocal atlas"
        }
      },
