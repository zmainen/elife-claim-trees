    {
      "@id": "urn:uuid:e2b21b80-fbbc-43ea-81ee-b6631c951e16",
      "@type": "mira:Protocol",
      "title": "gad-antibody-peripheral-penetration-only",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The anti-GAD antibody (Sigma-Aldrich G5163, rabbit polyclonal) used to detect GABAergic neurons in this atlas shows limited tissue penetration restricted to the periphery of the whole-mount preparation, reducing the utility of the GABAergic immunoreactivity channel for mapping interior neuropil structures; this limitation is acknowledged by the authors and affects interpretation of GABA patterns in deep neuropils such as the protocerebral bridge and arcuate body interior."
      },
      "cgx:epistemicStatus": "mira:Claim",
      "cg:role": "methodological",
      "cg:epistemicStrength": "strong",
      "cg:relations": {
        "requires": [
          {
            "@id": "urn:uuid:42987256-31b8-4f7d-b81f-8f6976a904f0"
          },
          {
            "@id": "urn:uuid:01384854-d4e5-4e8c-bf0b-239409c22675"
          }
        ]
      },
