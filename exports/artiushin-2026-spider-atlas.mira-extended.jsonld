    {
      "@id": "urn:uuid:b8667945-1d0c-4f6d-973b-b64bb9972ea0",
      "@type": "mira:Claim",
      "title": "protocerebral-bridge-candidate-central-complex",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "A structure consistent with a protocerebral bridge (potential spider equivalent of the insect central complex) is identified in the atlas, suggesting the spider brain contains a candidate homolog of circuits involved in path integration."
      },
