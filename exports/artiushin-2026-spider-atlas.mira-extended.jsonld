    {
      "@id": "urn:uuid:80deef22-24b8-4140-8141-276873993f34",
      "@type": "mira:Evidence",
      "schema:name": "mushroom-bodies-present-asta-exclusive",
      "schema:description": "Mushroom bodies are present in Uloborus diversus and retain the complete haft-body-head form with connecting bridge seen in cursorial spider species, contradicting reports of absent or simplified mushroom bodies in some web-building spider species; among all specific neurosignaling molecule antibodies tested, only allatostatin A (AstA) shows co-expression throughout the mushroom body, while other transmitter systems including 5-HT, TDC2, GABA, ChAT, proctolin, and CCAP do not.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.107732"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.35077/ace-owl-gum",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "immunofluorescence, anti-AstA / anti-synapsin, confocal atlas"
        }
      },
