    {
      "@id": "urn:uuid:42987256-31b8-4f7d-b81f-8f6976a904f0",
      "@type": "mira:Evidence",
      "schema:name": "protocerebral-bridge-layered-transmitter-architecture",
      "schema:description": "The protocerebral bridge (PCB) of Uloborus diversus displays a layered neurotransmitter architecture: GABAergic (anti-GAD) immunoreactivity defines a nearly complete swath of the neuropil; TDC2 (octopaminergic/tyraminergic) fills heavy chains of puncta along the posterior edge; proctolin forms a tight thin band primarily at the medial end; and ChAT (cholinergic) immunoreactivity forms a distinct thin layer on both the anterior and posterior edges, most clearly on the lateral portion.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.107732"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.35077/ace-owl-gum",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "immunofluorescence, multi-antibody panel, confocal atlas"
        }
      },
      "mira:supports": {
