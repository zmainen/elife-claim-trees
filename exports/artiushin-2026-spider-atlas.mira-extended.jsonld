    },
    {
      "@id": "urn:uuid:01384854-d4e5-4e8c-bf0b-239409c22675",
      "@type": "mira:Evidence",
      "title": "globuli-cells-cholinergic-gabaergic",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The globuli cell cluster at the mushroom body heads of Uloborus diversus is revealed by ChAT immunoreactivity and to a lesser extent by GAD immunoreactivity, indicating that the globuli cells represent cholinergic and GABAergic populations; this is consistent with prior demonstration of ChAT-positive globuli cells in C. salei."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.107732",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://doi.org/10.35077/ace-owl-gum"
      },
      "cgx:epistemicStatus": "mira:Claim",
      "cg:role": "empirical",
      "cg:epistemicStrength": "moderate",
