      "@id": "https://doi.org/10.35077/ace-owl-gum",
      "@type": "prov:Entity"
    },
    {
      "@id": "urn:uuid:eb91b6b6-92c0-483d-8f88-d75708ac94c6",
      "@type": "mira:Evidence",
      "title": "arcuate-body-layers-neurotransmitter-distinguished",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Co-staining with multiple neurotransmitter markers allows the arcuate body layers to be distinguished morphologically, where single-channel synapsin staining is insufficient to differentiate the layers."
      },
      "observationBase": {
        "@id": "https://doi.org/10.35077/ace-owl-gum"
      },
      "cgx:epistemicStatus": "mira:Claim",
      "cg:role": "empirical",
