    {
      "@id": "urn:uuid:80deef22-24b8-4140-8141-276873993f34",
      "@type": "mira:Evidence",
      "title": "mushroom-bodies-present-asta-exclusive",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Mushroom bodies are present in Uloborus diversus and retain the complete haft-body-head form with connecting bridge seen in cursorial spider species, contradicting reports of absent or simplified mushroom bodies in some web-building spider species; among all specific neurosignaling molecule antibodies tested, only allatostatin A (AstA) shows co-expression throughout the mushroom body, while other transmitter systems including 5-HT, TDC2, GABA, ChAT, proctolin, and CCAP do not."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.107732",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://doi.org/10.35077/ace-owl-gum"
      },
      "cgx:epistemicStatus": "mira:Claim",
      "cg:role": "empirical",
