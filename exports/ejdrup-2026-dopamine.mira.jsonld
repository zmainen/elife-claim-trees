    {
      "@id": "urn:uuid:e3b92961-38ad-41b2-a66f-65e328d33a2e",
      "@type": "mira:Evidence",
      "schema:name": "vs-low-active-fraction-resembles-ds-distribution",
      "schema:description": "VS at 5% active terminals produces a spatial DA distribution resembling DS at 100% active terminals, demonstrating VS operates in a low-focality high-coverage regime while DS requires dense terminal participation for equivalent spatial reach.",
