    {
      "@id": "urn:uuid:c3130ba5-465d-4f1a-a851-6796e72a1d72",
      "@type": "mira:Claim",
      "schema:name": "ds-vs-vmax-ratio-assumed",
      "schema:description": "The 3:1 DS:VS DAT Vmax ratio (DS = 6 µM·s⁻¹, VS = 2 µM·s⁻¹) is assumed from published literature rather than directly measured in this study; the immunostaining gradient (Figure 2—supplement 1) corroborates this assumption at the protein level but does not directly establish the functional Vmax ratio.",
      "mira:epistemicStatus": "mira:Assumption",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105214"
      },
      "haak:interprets": {
