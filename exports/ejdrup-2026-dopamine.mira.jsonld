    {
      "@id": "urn:uuid:1e689f9b-1bf5-4abd-98b9-daa3af67c795",
      "@type": "mira:Evidence",
      "schema:name": "vmax-only-parameter-driving-regional-difference",
      "schema:description": "Across parameter sweeps of active terminal fraction, quantal size, release probability, and firing rate, only DAT Vmax generates differential responses between DS and VS; all other parameters shift both regions proportionally without altering the regional contrast.",
      "mira:epistemicStatus": "mira:Claim",
