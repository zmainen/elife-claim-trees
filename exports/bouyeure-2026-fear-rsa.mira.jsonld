    },
    {
      "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e#question",
      "@type": "mira:Question",
      "schema:description": "Is it the case that prefrontal cortex represents fear-relevant contexts as distinct multivoxel patterns (context-specific coding), and this representational distinctness is the neural substrate that enables context-dependent fear renewal: participants whose PFC encodes contexts more distinctly during reversal will show stronger reinstatement of acquisition-phase fear memory traces when later tested in the original acquisition context?"
    },
    {
      "@id": "urn:uuid:74eb7450-8ad4-458a-b237-24832ed57b0a#question",
      "@type": "mira:Question",
      "schema:description": "Is it the case that reversal learning recruits two simultaneous representational strategies in different brain regions: generalization (treating newly dangerous CS-+ like CS++ in fear-network territory) for cues that share their current threat status with established cue classes, and item-specific updating (distinguishing changing-valence cues such as CS+- from stable cues) in higher-order cortex?"
    },
    {
      "@id": "urn:uuid:291d51bd-0ff0-493a-94e1-6814e0deba68#question",
      "@type": "mira:Question",
      "schema:description": "Is it the case that fear learning produces generalized (cross-item) neural representations of threatening cues in the canonical fear network: when an animal learns that a stimulus class is dangerous, the brain represents members of the class with overlapping multivoxel patterns rather than preserving item-specific patterns, so that any new exemplar of the class inherits the threat representation?"
    },
    {
      "@id": "urn:uuid:dc36ab32-bbed-480d-b05d-f833b100b1c3",
      "@type": "mira:Evidence",
      "schema:name": "behavioral-learning-confirms-contingencies",
      "schema:description": "US expectancy ratings follow the hierarchy CS++ > CS+- > CS-+ > CS-- across all experimental phases (LME: CS type F=479.35, p<0.0001; phase F=125.6, p<0.001; interaction p<0.001), confirming participants learned threat contingencies and their reversals.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "linear mixed effects model (lme4/lmerTest, Satterthwaite df, Bonferroni-corrected post-hoc Wilcoxon)"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:291d51bd-0ff0-493a-94e1-6814e0deba68"
        },
        {
          "@id": "urn:uuid:74eb7450-8ad4-458a-b237-24832ed57b0a"
        },
        {
          "@id": "urn:uuid:6ea9d399-1100-4329-8a02-ac61dd04e3d1"
        }
      ]
    },
    {
      "@id": "urn:uuid:4dbc065d-daa5-45e9-96d6-9012b33cb24c",
      "@type": "mira:Evidence",
      "schema:name": "context-specificity-increases-reversal",
      "schema:description": "Neural representations of contexts become more distinct (context-specific) during reversal learning compared to acquisition, particularly in prefrontal cortex, reflecting the need to separate safe and dangerous environments.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "RSA context specificity measure (within-context minus between-context similarity), cluster FWE 10k permutations"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:a5fe00c8-602d-4b28-a458-68a57619b2e3"
        },
        {
          "@id": "urn:uuid:2ff7f5ea-efaf-408e-9ef3-ab46fe395e74"
        },
        {
          "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e"
        }
      ]
    },
    {
      "@id": "urn:uuid:7ca6bb4e-6e66-47c1-bf7c-52c64d17d80d",
      "@type": "mira:Evidence",
      "schema:name": "context-specificity-predicts-acquisition-reinstatement-regional-dissociation",
      "schema:description": "Higher reversal context specificity (PFC) interacts with CS type to predict generalized reinstatement of acquisition memory traces in ACC/SFG (favoring initially threatening CS+-, t(22)=6.25, p<0.05) and precuneus (favoring initially safe CS-+, t(22)=4.89, p<0.01), with opposite directions across regions.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "LME with context specificity × CS type interaction predicting generalized reinstatement; FDR correction within ROI pairs"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e"
        },
        {
          "@id": "urn:uuid:2ff7f5ea-efaf-408e-9ef3-ab46fe395e74"
        }
      ],
      "haak:requires": {
        "@id": "urn:uuid:4dbc065d-daa5-45e9-96d6-9012b33cb24c"
      }
    },
    {
      "@id": "urn:uuid:d0bcf69c-c791-4b94-9d82-92a43bccc4ed",
      "@type": "mira:Evidence",
      "schema:name": "context-specificity-predicts-reinstatement-new-context-mtg",
      "schema:description": "Higher reversal context specificity (PFC) predicts greater item reinstatement of CS-+ than CS+- acquisition memory traces in MTG during test_new (t(22)=2.51, p<0.05), the phase with entirely new contexts, suggesting context specificity generalizes beyond the training context.",
      "mira:epistemicStatus": "mira:Assumption",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "LME with context specificity × CS type interaction predicting item reinstatement in MTG during test_new"
        }
      },
      "mira:supports": {
