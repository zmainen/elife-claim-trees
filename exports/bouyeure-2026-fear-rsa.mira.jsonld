    {
      "@id": "urn:uuid:2ff7f5ea-efaf-408e-9ef3-ab46fe395e74",
      "@type": "mira:Evidence",
      "schema:name": "pfc-context-specificity-predicts-renewal",
      "schema:description": "Prefrontal cortex context-specificity during reversal learning predicts subsequent fear renewal at test, linking context-specific neural coding to behavioral expression of fear.",
      "mira:epistemicStatus": "mira:Claim",
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "correlation: RSA context specificity × behavioral fear renewal"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:12cefa80-6075-43a5-b3ec-ce2a8527ec2c"
        },
        {
          "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e"
        }
      ],
      "haak:requires": {
        "@id": "urn:uuid:4dbc065d-daa5-45e9-96d6-9012b33cb24c"
      }
    },
    {
      "@id": "urn:uuid:a5fe00c8-602d-4b28-a458-68a57619b2e3",
      "@type": "mira:Claim",
      "schema:name": "prediction-context-specificity-increases-during-reversal",
      "schema:description": "If PFC context-specific coding is the substrate for context-dependent fear renewal, then context representations should become more distinct (greater within-context vs between-context pattern similarity) in PFC during reversal compared to acquisition, when context becomes newly relevant for predicting threat (the same cue can be safe in one context and dangerous in another).",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:derived-from": {
        "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e"
      }
    },
    {
      "@id": "urn:uuid:753f4a2e-8ab1-4e27-89be-67280c9d9a33",
      "@type": "mira:Claim",
      "schema:name": "prediction-cs-minus-plus-generalizes-reversal",
      "schema:description": "If the same generalization mechanism that operates during acquisition is recruited whenever threat is acquired, then during reversal the newly dangerous cue (CS-+, previously safe) should acquire generalized neural representations in fear-network regions, mirroring the pattern seen for CS++ during acquisition.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:derived-from": [
        {
          "@id": "urn:uuid:291d51bd-0ff0-493a-94e1-6814e0deba68"
        },
        {
          "@id": "urn:uuid:74eb7450-8ad4-458a-b237-24832ed57b0a"
        }
      ]
    },
    {
      "@id": "urn:uuid:060f6390-e191-4522-a7ac-28bc91151f75",
      "@type": "mira:Claim",
      "schema:name": "prediction-cue-generalization-fear-network-acquisition",
      "schema:description": "If fear learning recruits a generalization mechanism that encodes threatening cues with shared representations, then during initial acquisition CS+ items should show greater between-item neural pattern similarity than CS- items in canonical fear-network regions (dACC, SFG, caudate, insula), with the generalization signal detectable as a positive CS+ > CS- contrast on the cue-generalization RSA measure.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:derived-from": {
        "@id": "urn:uuid:291d51bd-0ff0-493a-94e1-6814e0deba68"
      }
    },
    {
      "@id": "urn:uuid:4f0c3ed8-434a-4ab0-8ee2-bbc3f9f5d18e",
      "@type": "mira:Claim",
      "schema:name": "prediction-item-stability-changing-cues-reversal",
      "schema:description": "If reversal learning recruits an item-specific updating strategy in addition to generalization, then changing-valence cues (CS+- and CS-+) should show elevated within-item neural pattern stability — distinguishing each item from its category-mates — in higher-order cortex (precuneus, IFG, prefrontal cortex), regions outside the canonical fear network.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:derived-from": {
        "@id": "urn:uuid:74eb7450-8ad4-458a-b237-24832ed57b0a"
      }
    },
    {
      "@id": "urn:uuid:12cefa80-6075-43a5-b3ec-ce2a8527ec2c",
      "@type": "mira:Claim",
      "schema:name": "prediction-pfc-context-specificity-tracks-renewal",
      "schema:description": "If PFC context-specific coding is the substrate for context-dependent fear renewal, then between-subject variability in PFC context specificity (during reversal) should covary with between-subject variability in subsequent reinstatement of acquisition-phase fear memory traces at test, with subjects who encode contexts more distinctly showing stronger reinstatement.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:derived-from": {
        "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e"
      }
    },
    {
      "@id": "urn:uuid:db8f67a5-9139-44fb-89c1-b30613fbadf5",
      "@type": "mira:Claim",
      "schema:name": "prior-threat-activates-fear-network-weakly",
      "schema:description": "During reversal, cues that were threatening during acquisition but not currently threatening (CS++) vs those that were safe during acquisition and currently threatening (CS-+) still show fear network activation — (CS++ > CS+-) > (CS-+ > CS--) — though to a lesser extent than the current-threat contrast, suggesting a lingering prior fear memory trace.",
      "mira:epistemicStatus": "mira:Assumption",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:supports": {
        "@id": "urn:uuid:6ea9d399-1100-4329-8a02-ac61dd04e3d1"
      },
      "haak:interprets": {
        "@id": "urn:uuid:0fce9813-0814-4bb8-86fd-12cd0c33bd98"
      },
      "haak:requires": {
        "@id": "urn:uuid:364302b6-4c41-4591-8df9-7800a8c674ff"
      }
    },
    {
      "@id": "urn:uuid:7d932232-9c15-45f3-8296-958d3fe84d2a",
      "@type": "mira:Protocol",
      "schema:name": "rsa-roi-derived-from-searchlight",
      "schema:description": "ROI-based RSA analyses (Fig 4B, Fig 5D) use ROIs derived from statistically significant clusters in the preceding searchlight analyses on the same dataset, without an independent ROI definition, creating a circularity that inflates the expected significance of ROI tests.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
