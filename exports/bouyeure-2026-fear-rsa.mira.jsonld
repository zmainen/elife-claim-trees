    {
      "@id": "urn:uuid:60dc4ad3-7400-4bd9-bf23-dfc403bdea39",
      "@type": "mira:Evidence",
      "schema:name": "no-item-stability-difference-acquisition",
      "schema:description": "During fear acquisition, item stability (within-cue neural pattern similarity) does not differ between CS+ and CS- cues anywhere in the brain, showing that threat learning selectively increases cross-item generalization but not single-item representational consistency.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "RSA searchlight, item-stability measure, cluster FWE 10k permutations (p<0.025 threshold)"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:6ea9d399-1100-4329-8a02-ac61dd04e3d1"
        },
