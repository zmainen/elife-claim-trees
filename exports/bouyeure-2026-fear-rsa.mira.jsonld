      }
    },
    {
      "@id": "urn:uuid:aa1a7bc0-0051-4dc7-bbba-2f96300645e0",
      "@type": "mira:Evidence",
      "schema:name": "item-stability-precuneus-pfc-reversal",
      "schema:description": "During reversal learning, item-specific (stable across phases) representations emerge in precuneus and prefrontal cortex for cues that change their threat value (CS+-), distinguishing the changing cue from the stable threats.",
      "mira:epistemicStatus": "mira:Claim",
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
