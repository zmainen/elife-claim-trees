    {
      "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e",
      "@type": "mira:Claim",
      "schema:name": "hypothesis-context-specificity-supports-renewal",
      "schema:description": "Prefrontal cortex represents fear-relevant contexts as distinct multivoxel patterns (context-specific coding), and this representational distinctness is the neural substrate that enables context-dependent fear renewal: participants whose PFC encodes contexts more distinctly during reversal will show stronger reinstatement of acquisition-phase fear memory traces when later tested in the original acquisition context.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:entails": [
        {
          "@id": "urn:uuid:a5fe00c8-602d-4b28-a458-68a57619b2e3"
        },
        {
          "@id": "urn:uuid:12cefa80-6075-43a5-b3ec-ce2a8527ec2c"
        }
      ],
      "mira:addresses": {
        "@id": "urn:uuid:ff1e0397-2e8f-40ad-b8a3-e36eeee81b4e#question"
      }
    },
    {
      "@id": "urn:uuid:74eb7450-8ad4-458a-b237-24832ed57b0a",
      "@type": "mira:Claim",
      "schema:name": "hypothesis-dual-strategy-reversal",
      "schema:description": "Reversal learning recruits two simultaneous representational strategies in different brain regions: generalization (treating newly dangerous CS-+ like CS++ in fear-network territory) for cues that share their current threat status with established cue classes, and item-specific updating (distinguishing changing-valence cues such as CS+- from stable cues) in higher-order cortex. The two strategies are not redundant — they encode complementary information about the same stimulus inventory.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:entails": [
        {
          "@id": "urn:uuid:753f4a2e-8ab1-4e27-89be-67280c9d9a33"
        },
        {
          "@id": "urn:uuid:4f0c3ed8-434a-4ab0-8ee2-bbc3f9f5d18e"
        }
      ],
      "mira:addresses": {
        "@id": "urn:uuid:74eb7450-8ad4-458a-b237-24832ed57b0a#question"
      }
    },
    {
      "@id": "urn:uuid:291d51bd-0ff0-493a-94e1-6814e0deba68",
      "@type": "mira:Claim",
      "schema:name": "hypothesis-fear-network-generalizes-threat-cues",
      "schema:description": "Fear learning produces generalized (cross-item) neural representations of threatening cues in the canonical fear network: when an animal learns that a stimulus class is dangerous, the brain represents members of the class with overlapping multivoxel patterns rather than preserving item-specific patterns, so that any new exemplar of the class inherits the threat representation. The same mechanism operates whenever threat is acquired, including during reversal when previously safe cues become dangerous.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "haak:entails": [
        {
          "@id": "urn:uuid:060f6390-e191-4522-a7ac-28bc91151f75"
        },
        {
          "@id": "urn:uuid:753f4a2e-8ab1-4e27-89be-67280c9d9a33"
        }
      ],
      "mira:addresses": {
        "@id": "urn:uuid:291d51bd-0ff0-493a-94e1-6814e0deba68#question"
      }
    },
    {
      "@id": "urn:uuid:bcf69f08-b30f-4571-9ecd-69ea60d15414",
      "@type": "mira:Evidence",
      "schema:name": "ifg-reinstates-reversal-traces-item-specific",
      "schema:description": "In IFG during test_old, item reinstatement is higher for reversal memory traces than for acquisition or test_new memory traces (F(2,253)=5.50, p<0.01), showing that IFG preferentially reinstates the most recently learned item-specific representations.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "ROI-based LME (reversal > acquisition item reinstatement, Wilcoxon t(253)=-3.01 p<0.01; reversal > test_new t(253)=-2.7 p<0.05)"
        }
      },
      "mira:supports": {
        "@id": "urn:uuid:6ea9d399-1100-4329-8a02-ac61dd04e3d1"
      },
      "mira:opposes": {
