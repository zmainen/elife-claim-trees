    {
      "@id": "urn:uuid:e5023cc6-f631-4d2b-b768-ed36dbef9edb",
      "@type": "mira:Evidence",
      "schema:name": "no-bold-differences-test-phases",
      "schema:description": "During both test phases (test_new and test_old), no significant BOLD activation differences between any CS type contrasts are found, despite significant US expectancy differences at the behavioral level, motivating RSA over univariate analysis.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
