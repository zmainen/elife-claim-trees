    {
      "@id": "urn:uuid:411ed78e-2542-4340-b896-bca7522579ae",
      "@type": "mira:Evidence",
      "schema:name": "cue-generalization-limited-dacc-reversal-consistent",
      "schema:description": "During reversal, cue generalization for CS++ (always threatening) vs CS-- (always safe) is elevated only in dACC, not in the broader fear network regions where this effect was present during acquisition, suggesting that consistent threat representations are maintained more narrowly.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "RSA searchlight, cue generalization measure, cluster FWE 10k permutations (Bonferroni-corrected alpha p<0.0125)"
        }
      },
      "mira:supports": [
