    {
      "@id": "urn:uuid:500caa5d-b636-4776-98fe-422b618f8e02",
      "@type": "mira:Evidence",
      "schema:name": "item-stability-persists-test-phases",
      "schema:description": "Item stability (but not cue generalization) persists into test phases in the absence of a US: CS+- > CS++ item stability in MTG at test_new, and CS++ > CS-- item stability in inferior temporal gyrus at test_old, showing that individual-item memory traces outlast the training context.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.105126"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.17605/OSF.IO/NGWKA",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "RSA searchlight, item-stability measure, cluster FWE 10k permutations (p<0.0125)"
        }
      },
      "mira:supports": {
        "@id": "urn:uuid:6ea9d399-1100-4329-8a02-ac61dd04e3d1"
      },
      "haak:requires": {
