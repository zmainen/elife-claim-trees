    {
      "@id": "urn:uuid:d903f2eb-e683-43c7-8feb-1bc1ee72597b",
      "@type": "mira:Claim",
      "schema:name": "trace-conditioning-hippocampus-engaged",
      "schema:description": "Trace conditioning (temporal gap between CS and US) is used to engage hippocampus-dependent memory formation; this design assumption is not independently validated in this paper but relies on prior literature establishing hippocampal involvement in trace conditioning.",
      "mira:epistemicStatus": "mira:Assumption"
    }
