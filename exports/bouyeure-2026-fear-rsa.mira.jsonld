    {
      "@id": "urn:uuid:9c4f7718-812e-45ec-aecd-3218135a1e4b",
      "@type": "mira:Protocol",
      "schema:name": "lss-unreinforced-trials-only",
      "schema:description": "All RSA pattern similarity analyses use only unreinforced trials (no US delivered), excluding reinforced trials to avoid US-driven BOLD confounds; this exclusion reduces the effective trial count and may selectively remove trials with strongest fear responses.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
