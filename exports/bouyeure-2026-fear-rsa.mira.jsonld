    {
      "@id": "urn:uuid:711a9296-c951-4455-b0bb-99e3d48ab36e",
      "@type": "mira:Evidence",
      "schema:name": "context-specificity-predicts-reversal-reinstatement-dmpfc",
      "schema:description": "Higher reversal context specificity (PFC) predicts greater item reinstatement of CS-+ than CS+- reversal memory traces in dmPFC during test_old (t(22)=5.56, p<0.05), favoring reinstatement of threatening reversal memories in the same region that generalizes acquisition traces.",
      "mira:epistemicStatus": "mira:Claim",
