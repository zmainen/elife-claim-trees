    {
      "@id": "urn:uuid:6ea9d399-1100-4329-8a02-ac61dd04e3d1",
      "@type": "mira:Claim",
      "schema:name": "dual-strategy-reversal-generalize-plus-specify",
      "schema:description": "Reversal learning recruits two distinct representational strategies simultaneously: generalization (treating newly dangerous CS-+ like old CS++) for currently dangerous cues, and item-specific updating (distinguishing CS+- from CS++) for cues with changing threat value.",
      "mira:epistemicStatus": "mira:Claim",
      "mira:supports": {
