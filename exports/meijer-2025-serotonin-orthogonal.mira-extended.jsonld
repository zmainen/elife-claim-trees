    {
      "@id": "urn:uuid:43dc14e4-5475-40a6-b981-fcbd00914ad4",
      "@type": "mira:Evidence",
      "schema:name": "cortical-layers-show-no-differential-modulation",
      "schema:description": "When cortical Neuropixel recordings are split by cortical layer, neither the percentage of significantly 5-HT-modulated neurons, the sign of the modulation, nor the onset latency shows a layer-dependent pattern — implying that any layer-specific receptor expression or axonal-targeting biases of dorsal-raphe serotonergic projections do not translate into a layer-specific population effect at this measurement scale.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "IBL ONE protocol",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "layer assignment from histology-aligned probe coordinates; per-layer comparison of fraction, sign, and latency"
        }
      },
      "haak:role": "control",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "requires": [
          {
            "@id": "urn:uuid:6979e5c6-acb6-4083-ba5a-5ad25845f8a0"
          }
        ]
