    },
    {
      "@id": "urn:uuid:83d656ca-94ec-4a0f-bfb1-1138605cc136",
      "@type": "dg:SourceDocument",
      "schema:name": "interprets-paquelet-correlated-ensembles",
      "schema:description": "Paquelet et al. (2022, Neuron) used calcium imaging in awake behaving mice to characterize population activity of DRN serotonergic neurons. Sucrose consumption activated correlated ensembles comprising up to ~59% of recorded serotonergic neurons; footshock activated correlated ensembles comprising up to ~45%. Across exploratory and social behaviors, serotonergic neurons were recruited as structured, correlated subpopulations with mixed selectivity — not as a uniform population-wide burst.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1016/j.neuron.2022.05.015"
      },
      "haak:role": "literature-context",
      "haak:epistemicStrength": "moderate",
      "haak:panel": "discussion (optogenetics-vs-endogenous scope paragraph)"
    },
    {
      "@id": "urn:uuid:ccfb7993-d675-4598-9858-1bc9f0e12ac2",
      "@type": "mira:Protocol",
      "schema:name": "manifold-from-pooled-super-session",
      "schema:description": "The manifold and orthogonality analyses (Fig. 5) are computed from a single pooled super-session: trial-averaged peri-event-time histograms (12.5 ms bins, 20 ms Gaussian smoothing) of every neuron from every session and every mouse are concatenated along the neuron axis, mean-subtracted per neuron, and projected to the first three principal components. Trials with reaction time <0.1 s or >1.2 s are excluded. Null distributions are generated by within-prior-block choice shuffles (preserving prior-induced choice structure) and by pseudo-stimulation-blocks (preserving block-length statistics) to avoid inflating significance through within-block temporal autocorrelation.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "haak:role": "methodological",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "enables-method": [
          {
            "@id": "urn:uuid:edaec7c9-e745-4a84-b73c-aea77cf4550b"
          },
          {
            "@id": "urn:uuid:cf85076a-1b1f-462c-ac7a-e6bd64306681"
          }
        ],
        "scopes": [
          {
            "@id": "urn:uuid:edaec7c9-e745-4a84-b73c-aea77cf4550b"
          },
          {
            "@id": "urn:uuid:cf85076a-1b1f-462c-ac7a-e6bd64306681"
          }
        ]
      },
      "haak:verification": [
        {
          "@type": "haak:VerificationRecord",
          "haak:agent": "mainen-z",
          "schema:date": "2026-04-20",
          "haak:status": "unverified",
          "haak:executed": false
        }
      ],
      "haak:panel": "methods (manifold analysis section)",
      "haak:analysis": "ref. 28 procedure (manifold methodology), implemented in https://github.com/guidomeijer/SerotoninStimulation"
    },
    {
      "@id": "urn:uuid:c4a03387-7441-4430-bffb-d7cfec4e0d75",
      "@type": "mira:Evidence",
      "schema:name": "narrow-spike-interneurons-not-driver-of-rapid-inhibition",
      "schema:description": "Narrow-spiking putative fast-spiking interneurons (separated from wide-spiking neurons by spike width, with their higher firing rates confirming the classification) are only marginally more likely to be 5-HT modulated than wide-spiking neurons, and show no significant difference in modulation index — ruling out preferential rapid recruitment of fast-spiking interneurons as the mechanism for the rapid inhibition observed in short-latency-suppressed regions.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "IBL ONE protocol",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "spike-width threshold classification of narrow vs wide; firing-rate validation; per-class fraction modulated and modulation-index comparison"
        }
      },
      "mira:opposes": {
        "schema:name": "rapid-fs-interneuron-recruitment-as-mechanism"
      },
      "haak:role": "control",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "rules-out": [
          {
            "schema:name": "rapid-fs-interneuron-recruitment-as-mechanism"
          }
        ],
        "requires": [
          {
            "@id": "urn:uuid:6979e5c6-acb6-4083-ba5a-5ad25845f8a0"
          }
        ]
      },
      "haak:verification": [
        {
          "@type": "haak:VerificationRecord",
          "haak:agent": "mainen-z",
          "schema:date": "2026-04-20",
          "haak:status": "unverified",
          "haak:executed": false
        }
      ],
      "haak:panel": "supp-fig3a, supp-fig3b, supp-fig3c, supp-fig3d",
      "haak:analysis": "figure-generation scripts in https://github.com/guidomeijer/SerotoninStimulation"
    },
    {
      "@id": "urn:uuid:cbe383df-b2a1-47d6-8337-605fa7c560bc",
      "@type": "mira:Claim",
      "schema:name": "optogenetic-activation-not-physiological-pattern",
      "schema:description": "SERT-Cre-mediated channelrhodopsin activation drives DRN serotonergic neurons broadly and more uniformly than endogenous serotonin release, which engages anatomically and functionally distinct subpopulations with distinct projection targets and behavioral correlates. Optogenetic drive itself is not spatially uniform either — light intensity falls off steeply from the fiber tip and ChR2-expressing neurons show frequency-dependent adaptation — but it nevertheless produces a coordinated phasic response unlike the ensemble-structured patterns observed during natural behavior.",
      "mira:epistemicStatus": "mira:Assumption",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "haak:role": "scope",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "interprets": [
          {
            "@id": "urn:uuid:83d656ca-94ec-4a0f-bfb1-1138605cc136"
          }
        ],
        "scopes": [
          {
            "@id": "urn:uuid:6979e5c6-acb6-4083-ba5a-5ad25845f8a0"
          },
          {
            "@id": "urn:uuid:e59d7d03-4f0f-4939-b88a-c604804a7bb2"
          },
          {
            "@id": "urn:uuid:edaec7c9-e745-4a84-b73c-aea77cf4550b"
          }
        ]
      },
      "haak:verification": [
        {
          "@type": "haak:VerificationRecord",
          "haak:agent": "mainen-z",
          "schema:date": "2026-04-20",
          "haak:status": "unverified",
          "haak:executed": false
        }
      ],
      "haak:panel": "discussion / scope"
    },
    {
      "@id": "urn:uuid:cf85076a-1b1f-462c-ac7a-e6bd64306681",
      "@type": "mira:Evidence",
      "schema:name": "orthogonality-significant-in-mpfc-vis-m2",
      "schema:description": "When the manifold orthogonality analysis is repeated separately for each brain region, at the last time point before the choice moment, the orthogonality between the 5-HT effect axis and the choice axis significantly exceeds the shuffle null distribution in three regions: medial prefrontal cortex, visual cortex, and supplementary motor area (M2). Other regions either lack significant choice or 5-HT separation (and so cannot be tested) or show non-significant orthogonality.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "IBL ONE protocol",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "per-region manifold analysis at last pre-choice timepoint, permutation test against block-aware null"
        }
      },
      "mira:supports": {
        "@id": "urn:uuid:677d38e8-8b0f-42cb-a194-293cf4899020"
      },
      "haak:role": "empirical",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
