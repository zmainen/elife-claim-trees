    {
      "@id": "urn:uuid:677d38e8-8b0f-42cb-a194-293cf4899020",
      "@type": "mira:Claim",
      "schema:name": "hypothesis-orthogonal-neuromodulatory-subspace",
      "schema:description": "A neuromodulatory signal can produce strong, brain-wide single-neuron modulation while leaving ongoing task-driven behavior unaffected if the modulation is geometrically confined to a population subspace orthogonal to the readout dimensions used by downstream circuits to extract task variables (here, the upcoming choice). Orthogonality permits a linear-readout downstream region to project onto either the choice subspace or the neuromodulatory subspace independently.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "haak:role": "hypothesis",
