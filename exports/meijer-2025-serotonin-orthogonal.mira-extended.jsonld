    {
      "@id": "urn:uuid:275ffb65-3c47-4736-9649-2fb33c1934ad",
      "@type": "mira:Evidence",
      "schema:name": "5ht-modulation-fraction-tracks-chr2-expression",
      "schema:description": "The fraction of significantly 5-HT-modulated neurons recorded per animal is positively correlated with the histologically measured channelrhodopsin expression level in that animal's DRN (Pearson r = 0.77, p = 0.005), establishing that the magnitude of the neural effect scales with the optogenetic drive — and ruling out a stimulation-condition-related artifact common across animals.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "IBL ONE protocol",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "Pearson correlation between per-mouse modulated-neuron fraction and per-mouse DRN/control fluorescence ratio"
        }
      },
      "mira:supports": {
        "@id": "urn:uuid:6979e5c6-acb6-4083-ba5a-5ad25845f8a0"
      },
