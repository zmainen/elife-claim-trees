    {
      "@id": "urn:uuid:1a5cd255-9f81-4e90-9fbc-e49873ac4e36",
      "@type": "mira:Claim",
      "schema:name": "prediction-5ht-accelerates-prior-update",
      "schema:description": "If 5-HT signals surprise and supports cognitive flexibility, then optogenetic 5-HT stimulation across blocks of trials should accelerate the rate at which the animal updates its choice bias after a prior-probability block switch — for example, after the prior switches from 80% left to 80% right, 5-HT-stimulated mice should reach the new rightward bias in fewer trials than unstimulated mice.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:bafb4184-4ce0-472e-a84f-9eba891bd417"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:4a9fe28d-cf62-4539-98f9-0f0e00126047",
      "@type": "mira:Claim",
      "schema:name": "prediction-5ht-axis-orthogonal-to-choice",
      "schema:description": "If brain-wide 5-HT modulation is structurally separable from the choice computation, then in a low-dimensional projection of the population response (here, the first three principal components), the vector that separates 5-HT-stimulated from unstimulated trials should be near-orthogonal to the vector that separates left-choice from right-choice trials, with orthogonality measured as 1 - |dot product| of unit-normalized direction vectors.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:677d38e8-8b0f-42cb-a194-293cf4899020"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:984ff53f-048b-4598-a0ef-6293bb0d7158",
      "@type": "mira:Claim",
      "schema:name": "prediction-5ht-shifts-psychometric",
      "schema:description": "If 5-HT functions as a surprise / belief-updating signal that scales prior dependence or motivation, then optogenetic 5-HT stimulation during the steering-wheel task should produce measurable shifts in at least one of: psychometric slope (visual acuity), bias (prior influence), lapse rate (motivation), percent-correct, reaction time, or in the weight assigned to the visual-evidence / prior / past-choice predictors of a probabilistic choice model.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:bafb4184-4ce0-472e-a84f-9eba891bd417"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:4f28c881-0692-4fcf-8595-2f4bcd0716af",
      "@type": "mira:Claim",
      "schema:name": "prediction-orthogonality-grows-toward-choice",
      "schema:description": "If the 5-HT modulation specifically avoids the choice readout dimension as that dimension becomes informative, then the orthogonality between the 5-HT axis and the choice axis should not be constant — it should grow over the trial timecourse, becoming maximal in the hundreds of milliseconds leading up to the choice moment, when the choice axis has separated maximally and the readout demand is greatest.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.1101/2025.08.01.668048"
      },
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:677d38e8-8b0f-42cb-a194-293cf4899020"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:a24358b5-0552-472b-8679-3d318d4d702f",
      "@type": "mira:Claim",
      "schema:name": "seven-target-trajectories-13-regions-7478-neurons",
      "schema:description": "All brain-wide claims in the paper rest on a recording dataset of 7,478 neurons sorted via the IBL spike-sorting pipeline from 86 dual-Neuropixel insertions across 57 recording sessions in 17 head-fixed awake mice (11 SERT-Cre, 6 WT), with insertion trajectories targeting seven planned brain locations and post-hoc histology-aligned to 13 brain regions in Allen atlas space.",
      "mira:epistemicStatus": "mira:Assumption",
      "dg:sourceDocument": {
