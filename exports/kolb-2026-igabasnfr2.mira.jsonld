    {
      "@id": "urn:uuid:81a3fe0f-a268-4abf-8ad5-b4abbdb4b2dc",
      "@type": "mira:Claim",
      "schema:name": "igabasnfr2-cpgfp-rigid-on-gaba-binding",
      "schema:description": "GABA binding to iGABASnFR2 closes the Venus flytrap lobes of the Pf622 domain but produces negligible conformational change in cpGFP and its flanking linkers (RMSD 0.25 Å), contrasting with the large cpGFP interface rearrangement seen in GCaMP upon calcium binding.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "mira:supports": [
