    {
      "@id": "urn:uuid:f2fccd5f-8ee8-4138-9e97-055ebda75cd8",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-invivo-barrel-cortex",
      "schema:description": "iGABASnFR2 detects volume-transmitted extracellular GABA signals in vivo in mouse barrel cortex (layers L2–L3, ~300 μm depth) evoked by rhythmic whisker stimulation, corresponding to a transient GABA concentration increase of approximately 2–2.5 μM at peak.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.5281/zenodo.17971101",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "in vivo 2P Tornado scanning (1 kHz resonant scan); AAV9-hSyn-iGABASnFR2 cortical injection; rhythmic whisker stimulation (4 air puffs at 20 Hz, 200 ms)"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:96510607-0b3e-42ef-8144-79bc0940eefe"
        },
        {
          "@id": "urn:uuid:ba1d6ed5-d8ba-40d2-b255-87315d83c216"
        },
        {
