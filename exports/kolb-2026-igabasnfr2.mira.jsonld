      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-fourfold-sensitivity-gain",
      "schema:description": "iGABASnFR2 exhibits a 4.1-fold improvement in ΔF/F sensitivity compared to iGABASnFR1 under equivalent stimulation conditions in cultured neurons, quantified by the high-throughput screening pipeline.",
