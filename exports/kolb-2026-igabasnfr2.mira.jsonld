    {
      "@id": "urn:uuid:96510607-0b3e-42ef-8144-79bc0940eefe#question",
      "@type": "mira:Question",
      "schema:description": "Is it the case that a GABA sensor with sufficiently improved sensitivity, kinetics, and affinity will cross qualitative capability thresholds — not merely improve signal-to-noise on measurements iGABASnFR1 could already make, but enable measurements that iGABASnFR1 cannot make at all?"
    },
    {
      "@id": "urn:uuid:ac2b204d-13a2-4aec-91b9-4792961bc503#question",
      "@type": "mira:Question",
      "schema:description": "Is it the case that targeted near-saturation mutagenesis at sites in and around the Pf622 GABA-binding pocket and the cpGFP-linker interfaces can yield a successor to iGABASnFR1 with substantially improved sensitivity (ΔF/F), increased on-cell affinity within the physiologically relevant range, faster binding kinetics, and improved expression / membrane trafficking — without sacrificing GABA selectivity?"
    },
    {
      "@id": "urn:uuid:f7d3b257-5ae5-4122-a122-0184b12b15f7",
      "@type": "mira:Protocol",
      "schema:name": "crystal-structure-pdb-9d57",
      "schema:description": "The crystal structure of iGABASnFR2 is deposited at the Protein Data Bank (accession 9D57), providing atomic-resolution structural information on the binding pocket and cpGFP domain arrangement.",
      "mira:epistemicStatus": "mira:Claim",
      "haak:enables-method": {
        "@id": "urn:uuid:81a3fe0f-a268-4abf-8ad5-b4abbdb4b2dc"
      }
    },
    {
      "@id": "urn:uuid:96510607-0b3e-42ef-8144-79bc0940eefe",
      "@type": "mira:Claim",
      "schema:name": "hypothesis-improved-sensor-enables-new-biology",
      "schema:description": "A GABA sensor with sufficiently improved sensitivity, kinetics, and affinity will cross qualitative capability thresholds — not merely improve signal-to-noise on measurements iGABASnFR1 could already make, but enable measurements that iGABASnFR1 cannot make at all. Specifically: detection of GABA release from individual inhibitory boutons in slice, single-trial detection of direction-selective GABA release from starburst amacrine cells in retina, and detection of volume-transmitted GABA in vivo following sensory stimulation.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "haak:entails": [
        {
          "@id": "urn:uuid:808a0591-b637-4f1a-9ff9-e05e779644bf"
        },
        {
          "@id": "urn:uuid:ff5506c7-eac9-42f7-8643-d38068feafd5"
        },
        {
          "@id": "urn:uuid:f2fccd5f-8ee8-4138-9e97-055ebda75cd8"
        }
      ],
      "mira:addresses": {
        "@id": "urn:uuid:96510607-0b3e-42ef-8144-79bc0940eefe#question"
      }
    },
    {
      "@id": "urn:uuid:ac2b204d-13a2-4aec-91b9-4792961bc503",
      "@type": "mira:Claim",
      "schema:name": "hypothesis-saturation-mutagenesis-yields-improved-sensor",
      "schema:description": "Targeted near-saturation mutagenesis at sites in and around the Pf622 GABA-binding pocket and the cpGFP-linker interfaces can yield a successor to iGABASnFR1 with substantially improved sensitivity (ΔF/F), increased on-cell affinity within the physiologically relevant range, faster binding kinetics, and improved expression / membrane trafficking — without sacrificing GABA selectivity. The performance ceiling of iGABASnFR1 is set by suboptimal residues at a small number of structurally identifiable positions, not by an intrinsic limit of the cpGFP-coupled Venus-flytrap scaffold.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "haak:entails": [
        {
          "@id": "urn:uuid:bce0de60-5b50-44e1-aafd-5d94c2f06e9b"
        },
        {
          "@id": "urn:uuid:ba1d6ed5-d8ba-40d2-b255-87315d83c216"
        }
      ],
      "mira:addresses": {
        "@id": "urn:uuid:ac2b204d-13a2-4aec-91b9-4792961bc503#question"
      }
    },
    {
      "@id": "urn:uuid:a8787aa1-9028-4ed0-827a-cdb38e9f59cb",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-13fold-expression-increase",
      "schema:description": "iGABASnFR2 shows a 13.1-fold increase in responsive pixels (expression-weighted response) compared to iGABASnFR1, indicating both improved sensitivity and membrane trafficking.",
      "mira:epistemicStatus": "mira:Claim",
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.5281/zenodo.17971101",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "fluorescence imaging, high-throughput screening"
        }
      },
      "mira:supports": [
