    {
      "@id": "urn:uuid:a56b114d-fbe5-422f-91cd-00a7de8b98ee",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-kinetics-rise-decay",
      "schema:description": "At 10 action potentials (83 Hz), iGABASnFR2 has a rise time constant of 43 ± 9 ms (faster than iGABASnFR1's 61 ± 13 ms) and a decay time constant of 73 ± 26 ms (slower than iGABASnFR1's 62 ± 29 ms), while iGABASnFR2n has a substantially slower rise time of 72 ± 8 ms.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.5281/zenodo.17971101",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "field stimulation in cultured neurons; exponential fits to ΔF/F₀ time courses; n=24 wells (iGABASnFR1, iGABASnFR2), n=18 wells (iGABASnFR2n)"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:ac2b204d-13a2-4aec-91b9-4792961bc503"
        },
        {
          "@id": "urn:uuid:f1d695b7-88cd-49d5-9fdc-f66cad65e1c8"
        }
      ],
      "mira:opposes": {
        "@id": "urn:uuid:f1d695b7-88cd-49d5-9fdc-f66cad65e1c8"
      }
    },
    {
      "@id": "urn:uuid:10eb034c-f5b4-422e-a43b-8375a917111d",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-oncell-affinity-sevenfold",
      "schema:description": "iGABASnFR2 expressed on the surface of cultured neurons has an on-cell EC50 of 6.4 ± 0.21 μM for GABA, representing a sevenfold higher affinity than iGABASnFR1 (EC50 ~45 μM on-cell) while remaining above the tonic extracellular GABA concentration range of 0.2–2.5 μM in the mammalian brain.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.5281/zenodo.17971101",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "on-cell fluorescence titration; GABA perfusion onto cultured neurons"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:ac2b204d-13a2-4aec-91b9-4792961bc503"
        },
        {
          "@id": "urn:uuid:f1d695b7-88cd-49d5-9fdc-f66cad65e1c8"
        },
        {
          "@id": "urn:uuid:f1d695b7-88cd-49d5-9fdc-f66cad65e1c8"
        }
      ],
      "mira:opposes": {
        "@id": "urn:uuid:f1d695b7-88cd-49d5-9fdc-f66cad65e1c8"
      }
    },
    {
      "@id": "urn:uuid:808a0591-b637-4f1a-9ff9-e05e779644bf",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-retina-direction-selectivity",
      "schema:description": "iGABASnFR2 directly demonstrates direction-selective GABA release from starburst amacrine cells in the intact retina, with significantly higher SNR and response reliability than iGABASnFR1; iGABASnFR1 signals were insufficient to detect direction selectivity even after trial-averaging.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.5281/zenodo.17971101",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "two-photon imaging in excised retina; Cre-Lox AAV delivery in ChAT-IRES-Cre mice; moving spot and full-field flash stimuli"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:96510607-0b3e-42ef-8144-79bc0940eefe"
