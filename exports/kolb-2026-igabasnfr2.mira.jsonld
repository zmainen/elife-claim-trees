    {
      "@id": "urn:uuid:669554c3-7a4d-453b-b9bd-893e935e630c",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-gaba-selective-specificity",
      "schema:description": "iGABASnFR2 displays high selectivity for GABA over structurally related compounds, none of which interfere with GABA binding as competitive or non-competitive antagonists at 1 mM concentrations.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "mira:observationBase": {
