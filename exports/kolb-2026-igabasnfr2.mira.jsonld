        "schema:identifier": "https://doi.org/10.5281/zenodo.17971101",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "fluorescence titration with GABA-related compounds; competition assay with 1 mM competitor + increasing GABA"
        }
      },
      "mira:supports": [
