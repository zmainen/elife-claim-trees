      "@type": "mira:Protocol",
      "schema:name": "igabasnfr2-2p-compatible",
      "schema:description": "iGABASnFR2 has two-photon excitation spectra similar to its one-photon spectra and is compatible with two-photon imaging; both v2 sensors show reduced pH dependence compared to iGABASnFR1.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
