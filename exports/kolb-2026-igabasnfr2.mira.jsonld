    {
      "@id": "urn:uuid:837eae22-f6f6-4d29-9696-c998ee633b7f",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2-single-exponential-kinetics",
      "schema:description": "iGABASnFR2 and iGABASnFR2n display single-exponential stopped-flow kinetics, whereas iGABASnFR1 exhibits biphasic kinetics; the observed reaction rate constants (Kobs) are far greater for both v2 sensors than for iGABASnFR1.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.108319"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.5281/zenodo.17971101",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "stopped-flow fluorescence spectroscopy; monoexponential fits in MATLAB"
        }
      },
