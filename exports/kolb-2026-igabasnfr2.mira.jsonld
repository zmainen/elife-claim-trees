    {
      "@id": "urn:uuid:305140b5-5720-45d7-8706-593e29243fb6",
      "@type": "mira:Evidence",
      "schema:name": "igabasnfr2n-negative-going-variant",
      "schema:description": "A negative-going variant (iGABASnFR2n) achieves -2.2-fold ΔF/F with 10.3-fold increased responsive pixels, providing an alternative sensor with inverted fluorescence change direction for applications requiring negative-going signals.",
      "mira:epistemicStatus": "mira:Claim",
