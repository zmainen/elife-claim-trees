    {
      "@id": "urn:uuid:4f75bdf1-62f6-4027-a3f4-b3ef47129364",
      "@type": "mira:Claim",
      "title": "hypothesis-d1-d2-temporal-distinction",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "D1 and D2 receptors encode dopamine signals on distinct temporal scales due to their different binding kinetics: D1 receptors (high EC50, fast on-rate) follow extracellular DA with millisecond delay and act as detectors of transient burst events, while D2 receptors (low EC50, slow off-rate) integrate the dopamine signal over seconds and cannot resolve brief pauses or closely spaced bursts."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "hypothesis",
      "haak:epistemicStrength": "hypothesis",
      "haak:relations": {
        "entails": [
          {
            "@id": "urn:uuid:2ec8fd67-7f5e-432f-b400-4e608348a74e"
          },
          {
            "@id": "urn:uuid:d6a177f1-603e-4318-a7e0-3ec10fe39da9"
          },
          {
            "@id": "urn:uuid:06c675dd-5a37-4e64-8af8-f02b15870215"
          }
        ]
      },
      "haak:panel": "hypothesis",
      "mira:addresses": {
        "@id": "urn:uuid:4f75bdf1-62f6-4027-a3f4-b3ef47129364#question"
      }
    },
    {
      "@id": "urn:uuid:08b37324-70f4-4ff9-bf37-c73d2b8a43c4",
      "@type": "mira:Claim",
      "title": "hypothesis-nanoclustering-regulates-vmax",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "DAT nanoclustering acts as a possible regulator of effective DAT activity in striatum: when transporters are concentrated into dense nanoclusters rather than uniformly distributed, local depletion at the cluster surface creates a diffusion-limited bottleneck that lowers the effective Vmax even at constant total DAT expression — proposing nanoclustering as one candidate mechanism for the lower effective Vmax in VS than DS."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "hypothesis",
      "haak:epistemicStrength": "hypothesis",
      "haak:relations": {
        "entails": [
          {
            "@id": "urn:uuid:dba3c7b4-0a96-48cb-97d4-9aca0edbe90f"
          },
          {
            "@id": "urn:uuid:498bf1d1-2d0f-42d4-bdf7-c9996ed5af78"
          }
        ]
      },
      "haak:panel": "hypothesis",
      "mira:addresses": {
        "@id": "urn:uuid:08b37324-70f4-4ff9-bf37-c73d2b8a43c4#question"
      }
    },
    {
      "@id": "urn:uuid:49eb1a86-3a61-4e0f-aa8e-f5c225b9df09",
      "@type": "mira:Claim",
      "title": "hypothesis-vmax-explains-regional-difference",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The qualitative regional contrast in extracellular dopamine dynamics between dorsal and ventral striatum — DS producing varicosity-scale hotspots with no pervasive tonic baseline versus VS producing diffuse tonic-like coverage — is principally explained by a difference in DAT Vmax (~3:1 DS:VS), rather than by differences in release-related parameters (vesicular content, release probability, active terminal fraction, or pacemaker firing rate)."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "hypothesis",
      "haak:epistemicStrength": "hypothesis",
      "haak:relations": {
        "entails": [
          {
            "@id": "urn:uuid:2ac9b38d-8f72-436d-905a-b98b7e8dc3ba"
          },
          {
            "@id": "urn:uuid:1ef1d1ae-1c10-4951-bd72-5fe9e3df202d"
          },
          {
            "@id": "urn:uuid:1e689f9b-1bf5-4abd-98b9-daa3af67c795"
          },
          {
            "@id": "urn:uuid:59c0aba5-a0e0-41d8-8961-fa5e927d83e7"
          },
          {
            "@id": "urn:uuid:e3b92961-38ad-41b2-a66f-65e328d33a2e"
          },
          {
            "@id": "urn:uuid:cc992651-67bd-4d1b-9237-fa13d9f9ec94"
          }
        ]
      },
      "haak:panel": "hypothesis",
      "mira:addresses": {
        "@id": "urn:uuid:49eb1a86-3a61-4e0f-aa8e-f5c225b9df09#question"
      }
    },
    {
      "@id": "urn:uuid:39079ccf-d87a-4e0b-83a9-a01369e54836",
      "@type": "dg:SourceDocument",
      "title": "interprets-cragg-rice-vmax-ratio",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Prior voltammetry and DAT-binding literature — notably Cragg & Rice (2004, TINS) and Kennedy and colleagues on in vivo fast-scan measurements — established a roughly 3:1 ratio of dopamine transporter Vmax between dorsal and ventral striatum, with DS at approximately 4–6 µM·s⁻¹ and VS at approximately 1.5–2 µM·s⁻¹. This Vmax asymmetry is the functional correlate of the DAT protein gradient seen across the dorsoventral striatal axis and has been treated as an empirical given in computational models of striatal DA dynamics."
      },
      "haakx:epistemicStatus": "mira:Claim",
      "haak:role": "literature-context",
      "haak:epistemicStrength": "moderate",
      "haak:panel": "fig2A (implied parameterization)"
    },
    {
      "@id": "urn:uuid:afbf7e64-20a0-4f3f-a748-8591ddc1e2d4",
      "@type": "dg:SourceDocument",
      "title": "interprets-may-wightman-1989-fscv",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "May & Wightman (1989, Brain Research) used fast-scan cyclic voltammetry (FSCV) in rat striatal slices to measure evoked extracellular dopamine transients across 10, 30, and 60 Hz electrical stimulation in dorsal and ventral striatum, and reported that ventral striatum reached substantially higher peak DA concentrations than dorsal striatum across all three frequencies. This slice-level dataset is the canonical empirical anchor for regional differences in striatal DA release dynamics."
      },
      "haakx:epistemicStatus": "mira:Claim",
      "haak:role": "literature-context",
      "haak:epistemicStrength": "moderate",
      "haak:panel": "fig2E (explicit replication comparison)"
    },
    {
      "@id": "urn:uuid:961ce4c4-5809-4b6b-aaa4-c5f52373612c",
      "@type": "mira:Evidence",
      "title": "low-burst-no-spillover-high-burst-does",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "3 APs at 10 Hz generates no significant DA spillover outside the burst zone; 6 APs at 20 Hz and 12 APs at 40 Hz cause frequency-dependent spillover exposing 10× and 30× the burst volume to concentrations above 100 nM respectively."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.105214",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://zenodo.org/record/17664800"
      },
      "haakx:epistemicStatus": "mira:Claim",
      "haak:role": "empirical",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "requires": [
          {
            "@id": "urn:uuid:2ac9b38d-8f72-436d-905a-b98b7e8dc3ba"
          }
        ]
      },
