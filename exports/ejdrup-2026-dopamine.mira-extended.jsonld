    {
      "@id": "urn:uuid:5b351222-ab85-46be-a673-b05a6f104f80",
      "@type": "mira:Claim",
      "title": "nanoclustering-constant-vmax-constraint",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The nanoclustering simulations hold total DAT Vmax constant across clustered and unclustered conditions — the per-voxel rate is multiplied by a normalization factor so total integrated uptake capacity is identical; if DAT nanoclustering co-occurs with increased total DAT expression in biology, the clearance-slowing result would not hold."
      },
      "haakx:epistemicStatus": "mira:Assumption",
      "haak:role": "scope",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "scopes": [
