      "haak:analysis": "Figure 4-Fig 4 simulations-Source code.py"
    },
    {
      "@id": "urn:uuid:8300c7dc-9386-4a06-9763-c3b681b5c282",
      "@type": "mira:Claim",
      "title": "nanoclustering-model-varicosity-scale",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The nanoclustering simulations (Figure 4C–F) operate in a standalone varicosity-scale model (1.8 × 1.8 µm domain, 0.02 µm voxels) architecturally separate from the tissue-level model used in Figures 1–3 (100 µm domain, 1 µm voxels); no formal coupling exists between the two models and no effective-Vmax output from the nanoclustering simulation feeds into the tissue simulation."
      },
      "haakx:epistemicStatus": "mira:Assumption",
      "haak:role": "scope",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
