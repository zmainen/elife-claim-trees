    {
      "@id": "urn:uuid:06c675dd-5a37-4e64-8af8-f02b15870215",
      "@type": "mira:Evidence",
      "title": "d2r-insensitive-to-brief-pauses",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "A complete 1 s pause in firing reduces D2R occupancy from approximately 0.55 to 0.45 only; this finding is robust across an order of magnitude of D2R affinity (2–20 nM)."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.105214",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://zenodo.org/record/17664800"
      },
