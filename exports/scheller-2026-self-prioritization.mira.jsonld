    {
      "@id": "urn:uuid:74cdf20e-9cfb-42ae-88cc-956527bc4af7",
      "@type": "mira:Claim",
      "schema:name": "self-prioritization-automatic-early",
      "schema:description": "Self-association enhances attentional selection automatically at the perceptual feature level — it emerges without explicit social decoding (perceptual decision condition, Experiment 1) and is reduced or reversed when social identity decoding is required (social decision condition, Experiments 1 and 2), indicating that self-prioritization in attentional selection is an early, pre-conscious process distinct from later social cognition.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      },
      "mira:supports": {
        "@id": "urn:uuid:7602af86-ca7d-4e6e-9c19-22e0e4bf5b47"
      }
    },
    {
      "@id": "urn:uuid:0b72064e-d0fc-43e9-a2d0-2d5044cde51e",
      "@type": "mira:Evidence",
      "schema:name": "self-prioritization-perceptual-decision-automatic",
      "schema:description": "In the perceptual decision dimension (report which shape flickered first), self-associated stimuli were processed 1.5 Hz faster than other-associated stimuli [HDI95: −0.16 to 3.2 Hz], driven by a capacity increase of 2.6 Hz and a self-associated rate increase of 2.1 Hz [HDI95: 0.13 to 4.1 Hz]; other-associated stimulus rate showed no consistent increase (0.53 Hz [HDI95: −1.4 to 2.5 Hz]).",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://osf.io/a62df",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "hierarchical Bayesian TVA estimation, Experiment 1 (N=69)"
        }
      },
