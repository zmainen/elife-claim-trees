    {
      "@id": "urn:uuid:63ea3299-4288-46d1-b563-784d69f364cf",
      "@type": "mira:Claim",
      "schema:name": "social-perceptual-salience-independent-streams",
      "schema:description": "Social salience and perceptual salience operate via largely independent mechanisms in attentional selection: their effects are additive for other-associated stimuli (interaction term -0.54 Hz, HDI includes zero), confirming that arbitrary social association and physical salience capture attention through separate processing streams rather than a single shared resource.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      },
      "mira:supports": {
        "@id": "urn:uuid:72d45d61-25fa-4831-b57e-3a7da5d097e3"
      }
    },
    {
      "@id": "urn:uuid:7a683a00-fc93-4d25-ae38-48734f0a8789",
      "@type": "mira:Evidence",
      "schema:name": "spe-matching-correlates-social-decision",
      "schema:description": "Individual self-prioritization effects in the shape-label matching task correlate with socially induced processing rate changes in the social decision dimension in Experiment 1 (r = 0.354, BF10 = 8.23, 95% CI: 0.11 to 0.54) but not in the perceptual decision dimension (r = 0.069, BF10 = 0.181).",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://osf.io/a62df",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "Bayesian correlation, Experiment 1 (N=69)"
        }
      },
      "mira:supports": {
        "@id": "urn:uuid:2189823e-209f-479b-a068-032f5fba3818"
      }
    },
    {
      "@id": "urn:uuid:0eef258f-1e89-4298-a762-c0c4a877ab9a",
      "@type": "mira:Evidence",
      "schema:name": "spe-robust-matching-both-experiments",
      "schema:description": "Strong self-prioritization effects are present in the shape-label matching task in both experiments: Experiment 1 (N=69) d = -1.064 [CI95: -1.38 to -0.75], BF10 = 3.23×10^95; Experiment 2 (N=71) d = -0.982 [CI95: -1.20 to -0.77], BF10 = 4.47×10^109, confirming participants learned and retained the self-associations used in the TOJ task.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      },
      "mira:observationBase": {
