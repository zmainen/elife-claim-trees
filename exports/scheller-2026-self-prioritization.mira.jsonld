    },
    {
      "@id": "urn:uuid:b32daec4-44c8-409c-8c3c-e7a1d13eb526",
      "@type": "mira:Evidence",
      "schema:name": "self-social-additive-perceptual",
      "schema:description": "The combination of social association and perceptual salience for other-associated stimuli produces effects consistent with additivity: the interaction term for other-associated salient stimuli is -0.54 Hz [HDI95: -2.4 to 1.4 Hz], indistinguishable from zero, indicating that social and perceptual salience operate via independent mechanisms for other-associated stimuli.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      },
      "mira:observationBase": {
