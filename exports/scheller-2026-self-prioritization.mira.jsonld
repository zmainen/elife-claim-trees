    {
      "@id": "urn:uuid:fcc24782-2506-4c9e-908a-baa03bb791fb",
      "@type": "mira:Claim",
      "schema:name": "self-salience-dominates-other-associated",
      "schema:description": "For perceptually salient self-associated stimuli, social salience effects are the stronger predictor (BFinclusion = 2458.52) while perceptual salience also contributes; for perceptually salient other-associated stimuli, perceptual salience dominates (BFinclusion = 4638.74), with social salience having a weaker role.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      }
    },
    {
      "@id": "urn:uuid:d5cc37f8-3738-4acf-95de-3c10a177aa69",
      "@type": "mira:Evidence",
      "schema:name": "self-salience-reduces-perceptual-benefit",
      "schema:description": "Perceptual salience benefit is substantially reduced for self-associated stimuli (2.5 Hz [HDI95: 0.86 to 4.1 Hz]) compared to other-associated (5.2 Hz [HDI95: 3.6 to 6.9 Hz]) or non-socially-associated perceptually salient stimuli (6 Hz [HDI95: 4.6 to 7.3 Hz]), indicating a sub-additive interaction when social self-relevance and perceptual salience co-occur.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
      },
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://osf.io/a62df",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "hierarchical Bayesian TVA, condition comparison, Experiment 2 (N=71)"
        }
      },
