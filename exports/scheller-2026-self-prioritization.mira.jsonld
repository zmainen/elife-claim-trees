    {
      "@id": "urn:uuid:24c24fef-2404-41a6-a0ea-edfe81cd3707",
      "@type": "mira:Protocol",
      "schema:name": "tva-capacity-model-wins",
      "schema:description": "Model comparison via leave-one-out cross-validation shows that a model with condition-specific processing capacity parameters outperforms a single-capacity model (Δloo=14.2, Δse=6.41, weight=0.86 pooled across N=140 participants), indicating that social salience changes absolute processing rates rather than merely redistributing attentional weights.",
      "mira:epistemicStatus": "mira:Claim",
      "dg:sourceDocument": {
        "schema:identifier": "doi:10.7554/eLife.100932"
