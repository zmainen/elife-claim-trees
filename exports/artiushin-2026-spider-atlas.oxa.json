        {
          "type": "Claim",
          "identifier": "atlas-observational-scope",
          "role": "scope",
          "children": [
            {
              "type": "Text",
              "value": "All primary claims in this paper are observational anatomical facts about the presence and distribution of neurotransmitters in identified neuropils; none are statistical in the conventional sense — the evidence is the 3D atlas itself, and reproduction means re-registering the same volumes or inspecting the deposited atlas, not re-computing statistics."
            }
          ],
