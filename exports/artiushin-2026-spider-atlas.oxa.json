        {
          "type": "Claim",
          "identifier": "cheliceral-neuropil-serotonin-tdc2-dominant",
          "role": "empirical",
          "children": [
            {
              "type": "Text",
              "value": "The cheliceral neuropil of Uloborus diversus is most abundantly innervated by serotonergic (anti-5-HT, fine varicosities filling the neuropil) and octopaminergic/tyraminergic (anti-TDC2, large puncta throughout) immunoreactivity; both populations also show pronounced signal in a region immediately medial to the cheliceral neuropil, where allatostatin A (AstA) additionally shows strong immunoreactivity."
            }
          ],
          "epistemicStrength": "strong",
          "relations": [
            {
              "xref": "pedipalpal-neuropil-chat-tdc2-dominant",
              "relationType": "cito:disagreesWith"
            },
            {
              "xref": "leg-neuropils-consistent-innervation",
              "relationType": "cito:disagreesWith"
            }
          ],
          "metadata": {
