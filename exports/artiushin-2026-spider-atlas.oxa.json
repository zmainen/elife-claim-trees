            "concepts": [
              "cheliceral neuropil",
              "serotonin",
              "octopamine",
              "tyramine",
              "TDC2",
              "allatostatin A",
              "spider deutocerebrum"
            ]
          }
        },
        {
          "type": "Claim",
          "identifier": "gad-antibody-peripheral-penetration-only",
          "role": "methodological",
          "children": [
            {
              "type": "Text",
              "value": "The anti-GAD antibody (Sigma-Aldrich G5163, rabbit polyclonal) used to detect GABAergic neurons in this atlas shows limited tissue penetration restricted to the periphery of the whole-mount preparation, reducing the utility of the GABAergic immunoreactivity channel for mapping interior neuropil structures; this limitation is acknowledged by the authors and affects interpretation of GABA patterns in deep neuropils such as the protocerebral bridge and arcuate body interior."
            }
          ],
          "epistemicStrength": "strong",
          "relations": [
            {
              "xref": "protocerebral-bridge-layered-transmitter-architecture",
              "relationType": "claimrel:requires"
            },
