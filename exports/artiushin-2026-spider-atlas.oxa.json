        {
          "type": "Claim",
          "identifier": "leg-neuropil-serotonin-bilateral-innervation",
          "role": "empirical",
          "children": [
            {
              "type": "Text",
              "value": "Serotonergic (5-HT) innervation in the leg neuropils of Uloborus diversus fills the neuropil in two roughly equal halves, with immunoreactivity supplied from the medial branch of the dorsal-most tract and leaving a central void, a pattern distinct from the uniform mesh-like dopaminergic innervation and the anterior/posterior differential of TDC2 signal in the same structures."
            }
          ],
          "epistemicStrength": "strong",
