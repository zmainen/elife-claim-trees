        {
          "type": "Claim",
          "identifier": "leg-neuropils-consistent-innervation",
          "role": "empirical",
          "children": [
            {
              "type": "Text",
              "value": "The four pairs of leg neuropils (LN1-LN4) display consistent innervation patterns across legs for the neurotransmitters mapped, indicating stereotyped neurochemical organization of the locomotor system."
            }
          ],
          "epistemicStrength": "moderate",
          "relations": [
