        {
          "type": "Claim",
          "identifier": "arcuate-body-layers-neurotransmitter-distinguished",
          "role": "empirical",
          "children": [
            {
              "type": "Text",
              "value": "Co-staining with multiple neurotransmitter markers allows the arcuate body layers to be distinguished morphologically, where single-channel synapsin staining is insufficient to differentiate the layers."
            }
          ],
          "epistemicStrength": "moderate",
