    {
      "@id": "urn:uuid:5e63c146-b0e8-457b-8fdc-5751afaefb2a",
      "@type": "mira:Evidence",
      "schema:name": "u-shaped-eccentricity-rejects-spillover",
      "schema:description": "Decoding accuracy in the experimental condition follows a U-shaped function of eccentricity — stronger at foveal and peripheral regions, weaker at parafoveal regions — in all early visual areas (V1: t(27)=3.98, p=0.008; V2: t(27)=3.03, p=0.02; V3: t(27)=2.776, p=0.025, one-sided quadratic curvature), ruling out peripheral spillover as an explanation for foveal decoding.",
      "mira:epistemicStatus": "mira:Claim",
      "mira:observationBase": {
        "@type": "mira:Study",
        "schema:identifier": "https://doi.org/10.18112/openneuro.ds005933.v1.0.0",
        "mira:follows": {
          "@type": "mira:Protocol",
          "schema:name": "weighted quadratic regression on eccentricity-binned decoding accuracy, fMRI"
        }
      },
      "mira:supports": [
        {
          "@id": "urn:uuid:7b2c3d4e-5f6a-4b01-9c02-2d3e4f5a6b7c"
        },
        {
          "@id": "urn:uuid:a4af1338-dbef-4dad-ba5d-699735dc08df"
        },
        {
          "@id": "urn:uuid:8a1c2d4e-9b3f-4a01-bc02-1d2e3f4a5b6c"
        }
      ],
      "mira:opposes": {
        "schema:name": "passive spillover from large peripheral receptive fields"
      },
      "haak:role": "control",
      "haak:epistemicStrength": "strong",
      "haak:relations": {
