    {
      "@id": "urn:uuid:3af0625b-efea-46a1-93d6-60b55f7506e9",
      "@type": "mira:Evidence",
      "schema:name": "ips-foveal-effect-reverses-in-control",
      "schema:description": "In the control condition (direct foveal stimulation), IPS activation is significantly negatively associated with foveal decoding (t(27)=−3.61, p=0.004, difference=11.6), the opposite direction to the experimental condition, confirming that the IPS–foveal decoding relationship is specific to the feedback context.",
      "mira:epistemicStatus": "mira:Claim",
