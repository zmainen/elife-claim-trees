    {
      "@id": "urn:uuid:5d4e5f6a-7b8c-4d01-9e02-4f5a6b7c8d9e",
      "@type": "mira:Claim",
      "schema:name": "prediction-cross-decoding-generalizes",
      "schema:description": "If foveal feedback shares a representational format with bottom-up sensory drive, a classifier trained on foveal V1 responses in the experimental (feedback) condition should generalize above chance to foveal V1 responses in the control (direct stimulation) condition for the same images.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:6c3d4e5f-7a8b-4c01-9d02-3e4f5a6b7c8d"
          }
        ]
      },
      "haak:panel": "hypothesis",
      "haak:analysis": "paper Results framing for fig2B cross-decoding"
    },
    {
      "@id": "urn:uuid:2a7b8c9d-0e1f-4a01-b002-7c8d9e0f1a2b",
      "@type": "mira:Claim",
      "schema:name": "prediction-lo-inverse-pattern",
      "schema:description": "If feedback content is selected by the representational level of the receiving cortex, then lateral occipital cortex (LO) — a high-level object-selective region — should show the inverse profile to foveal V1 under feedback: cross-shape decoding should drop while cross-category decoding should remain preserved.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:4e5f6a7b-8c9d-4e01-9f02-5a6b7c8d9e0f"
          }
        ]
      },
      "haak:panel": "hypothesis",
      "haak:analysis": "paper Results framing for fig3B"
    },
    {
      "@id": "urn:uuid:7b2c3d4e-5f6a-4b01-9c02-2d3e4f5a6b7c",
      "@type": "mira:Claim",
      "schema:name": "prediction-u-shape-eccentricity",
      "schema:description": "If foveal V1 decoding is genuine top-down feedback rather than passive spillover from large peripheral receptive fields, the eccentricity profile of decoding accuracy in early visual cortex should dip parafoveally and rise again at the fovea (a U-shaped curve), rather than decay monotonically from the peripheral target representation toward the fovea.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:8a1c2d4e-9b3f-4a01-bc02-1d2e3f4a5b6c"
          }
        ]
      },
      "haak:panel": "hypothesis",
      "haak:analysis": "paper Results framing for fig2B"
    },
    {
      "@id": "urn:uuid:3f6a7b8c-9d0e-4f01-a002-6b7c8d9e0f1a",
      "@type": "mira:Claim",
      "schema:name": "prediction-v1-category-drops-shape-preserved",
      "schema:description": "If foveal feedback carries shape but not semantic category information, then in foveal V1, cross-category decoding should drop significantly under feedback (relative to direct stimulation or to a within-category baseline), while cross-shape decoding should remain comparatively preserved.",
      "mira:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:4e5f6a7b-8c9d-4e01-9f02-5a6b7c8d9e0f"
          }
        ]
      },
      "haak:panel": "hypothesis",
      "haak:analysis": "paper Results framing for fig3"
    },
