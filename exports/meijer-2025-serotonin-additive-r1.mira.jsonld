    {
      "@id": "haak:edge/meijer-2025-serotonin-additive-r1/6",
      "@type": [
        "haak:reldef/requires"
      ],
      "source": "urn:uuid:a95a99d0-5af2-4711-8941-be2d0713688c",
      "destination": "urn:uuid:3709a410-d465-4bb2-9386-e08e680a19a1",
