    {
      "@id": "x:n54",
      "@type": [
        "x:_schema_Evidence",
        "Evidence"
      ],
      "title": "In Study 2, dot products between individual guilt-related response maps and the published guilt-related brain signature were overall positive (mean = 5.22, median = 6.97, sign test p = 0.017, Cliff's…",
      "content": "In Study 2, dot products between individual guilt-related response maps and the published guilt-related brain signature were overall positive (mean = 5.22, median = 6.97, sign test p = 0.017, Cliff's Delta = 0.4), ranging from –40.1 to 36.7.\n\nInter-individual differences in these dot products did not correlate with the behavioural guilt effect (Spearman's Rho = –0.058, p = 0.725).",
      "created": "2026-10-16T13:00:37.200Z",
      "modified": "2026-10-16T13:00:37.200Z",
      "creator": "x:agent",
      "description": "x:a-n54",
      "sourceDocument": "https://doi.org/10.7554/eLife.105391"
    },
