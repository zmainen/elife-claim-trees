      "@type": [
        "x:_schema_Study",
        "Study"
      ],
      "title": "Neuroimaging study of seeking or avoiding responsibility, in which participants could delegate a risky-versus-safe choice affecting themselves or a group to the group or decide themselves (Edelson et…",
      "content": "Neuroimaging study of seeking or avoiding responsibility, in which participants could delegate a risky-versus-safe choice affecting themselves or a group to the group or decide themselves (Edelson et al., 2018).",
      "created": "2026-10-16T13:00:37.200Z",
