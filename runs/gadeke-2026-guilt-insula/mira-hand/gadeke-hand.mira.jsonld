  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:e_grbs",
   "@type": [
    "cg:type/Evidence",
    "Evidence"
   ],
   "title": "Dot products between individual guilt-related maps and the published guilt signature were overall positive (mean 5.22, median 6.97, sign test p = 0.017, Cliff's delta 0.4).",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Study 2 · Results (neurometrics). — Anchor: “overall these values were positive (mean = 5.22; median = 6.97; sign test: p = 0.017; Cliff’s Delta = 0.4 = medium effect size”"
   },
   "sourceDocument": "https://doi.org/10.7554/eLife.105391.2"
  },
  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:e_grbs_indiv",
   "@type": [
    "cg:type/Evidence",
    "Evidence"
   ],
   "title": "The signature match did not correlate with individual behavioural guilt effects (Spearman's ρ = -0.058, p = 0.725).",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Study 2 · Results (neurometrics). A null that qualifies the convergent-validity reading; attached to the finding it bears on. — Anchor: “did not find a significant association [Spearman’s Rho = -0.058, p = 0.725]”"
   },
   "sourceDocument": "https://doi.org/10.7554/eLife.105391.2"
  },
  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:r_emotions",
   "@type": [
    "cg:type/Request",
    "Request"
   ],
   "title": "Ask participants directly which emotions they felt at each stage of the task, to link subjective experience to the analytical measures of guilt.",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Future work the Discussion calls for. — Anchor: “asking participants directly about which emotions they have felt during the different stages of this task would allow us to link subjective experience with our analytical measures”"
   }
  },
  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:r_traits",
   "@type": [
    "cg:type/Request",
    "Request"
   ],
   "title": "Test more participants to assess how personality traits shape the experience and the behavioural and neural correlates of guilt and responsibility.",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Future work the Discussion calls for. — Anchor: “Testing more participants would allow us to assess the impact of inter-individual variations in personality traits”"
   }
  },
  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:r_trials",
   "@type": [
    "cg:type/Request",
    "Request"
   ],
   "title": "Run more trials so risk preferences can be modelled separately for gains and losses per condition, and to test whether happiness changes affect later choices.",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Future work the Discussion calls for. — Anchor: “Using more trials in the experiment would allow separate modelling of risk preferences in gain and loss trials in each experimental condition”"
   }
  },
  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:r_partners",
   "@type": [
    "cg:type/Request",
    "Request"
   ],
   "title": "Vary the partner's identity — friend, stranger, artificial agent — to measure social discounting of guilt and responsibility.",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Future work the Discussion calls for. — Anchor: “Varying partner identities (friends, stranger, artificial agent) could reveal the impact of social discounting on guilt and responsibility”"
   }
  },
  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:r_feedback_ppi",
   "@type": [
    "cg:type/Request",
    "Request"
   ],
   "title": "Run the connectivity analyses on the outcome (feedback) phase of the task.",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Future work the Discussion calls for. — Anchor: “Functional connectivity analyses could also be performed for the data obtained in the feedback part of the paradigm”"
   }
  },
  {
   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:r_computations",
   "@type": [
    "cg:type/Request",
    "Request"
   ],
   "title": "Run experiments that isolate the specific computations the left STS/TPJ and anterior insula perform, to explain how guilt and responsibility shape social decisions.",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Future work the Discussion calls for. — Anchor: “More experiments investigating specific computations in which these regions are involved”"
   }
