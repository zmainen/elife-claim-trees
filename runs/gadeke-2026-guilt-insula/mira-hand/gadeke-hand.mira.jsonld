   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "In the scanner study, choosing for two made no difference to how often the lottery was chosen. — Anchor: “this difference was not found in Study 2 (t(3829) = 0.23, p = 0.82, β = 0.015”"
   },
   "sourceDocument": "https://doi.org/10.7554/eLife.105391.2",
