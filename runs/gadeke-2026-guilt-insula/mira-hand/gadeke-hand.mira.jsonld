   "@type": [
    "cg:type/Evidence",
    "Evidence"
   ],
   "title": "In Study 1, participants chose the lottery more often in the Solo than the Social condition (t(4796) = 2.54, p = 0.011, β = 0.164).",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "In the first study, participants chose the lottery a little more often when choosing for themselves alone. — Anchor: “Participants chose the lottery more often in the Solo condition than in the Social condition in Study 1 (t(4796) = 2.54, p = 0.011, β = 0.164”"
   },
   "sourceDocument": "https://doi.org/10.7554/eLife.105391.2",
   "observationBase": "https://iiif.elifesciences.org/epp/105391%2Fv2%2Fcontent%2F107300v6_fig2.tif/full/max,/0/default.jpg"
  },
