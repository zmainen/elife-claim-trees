   "@id": "urn:claim-graphs:gadeke-2026-guilt-insula:hand:e_insula_roi",
   "@type": [
    "cg:type/Evidence",
    "Evidence"
   ],
   "title": "Insula ROIs responded more to the partner's low outcomes in the Social than the Partner condition, also after subtracting responses to high outcomes.",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Study 2 · Figure 4E. — Anchor: “the insulae showed the sought-after effect (see Supplementary Table 6 and Figure 4E)”"
   },
   "sourceDocument": "https://doi.org/10.7554/eLife.105391.2",
   "observationBase": "https://iiif.elifesciences.org/epp/105391%2Fv2%2Fcontent%2F107300v6_fig4.tif/full/max,/0/default.jpg"
  },
