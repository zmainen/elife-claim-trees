---
// The layer graph as bands down the page, instead of a canvas you pan or a strip you scroll.
//
// The two existing views both spend the scarce axis on the pipeline's long one. Columns put
// nine depths across the width and overflow to 1680px, so most of the map is off-screen and
// the reader drags a scrollbar to see it. The graph view fits by zooming out, which buys the
// whole shape at the cost of being able to read any node in it, and then asks for pan and
// zoom to get back what the zoom took away.
//
// Depth is an order, and the page already has an unbounded axis for orders: down. Bands turn
// the long axis into scroll-the-page, which is free, and spend the width on what actually
// wants it — the layers within a depth, which have no order among themselves and can wrap.
// Nothing is off-screen, nothing needs fitting, and 375px and 1440px differ only in how many
// chips sit on a line.
//
// It also gets to drop the edges. In a DAG drawn by depth every arrow points from a lower
// band to a higher one, so direction is carried by position and the lines are redundant —
// which is what made the graph view hard to read, twenty-eight nodes' worth of crossings
// drawn to say what the layout already said. Selecting a layer marks what feeds it and
// everything downstream of it instead, and answers the question the arrows only let you
// trace by eye: what goes stale if I change this.
import type { ExplorerData, LayerView } from '../lib/explorer';

interface Props { data: ExplorerData }
const { data } = Astro.props;

const maxDepth = Math.max(0, ...data.layers.map(l => l.depth));
const bands = Array.from({ length: maxDepth + 1 }, (_, d) => ({
  depth: d,
  layers: data.layers.filter(l => l.depth === d),
}));

// The needs map is the whole graph, and it is small — twenty-eight entries. Handing it over
// whole lets the selection compute a transitive closure in the browser without a request.
const edges = Object.fromEntries(data.layers.map(l => [l.id, l.needs]));

const pct = (l: LayerView) => l.fill && l.fill.total ? Math.round((l.fill.done / l.fill.total) * 100) : 0;
---

<div class="bands" data-edges={JSON.stringify(edges)}>

  <p class="bands-hint text-xs text-gray-500 dark:text-gray-400 m-0 mb-3">
    Every layer rests on a band above it. Pick one to see what feeds it, and what falls out of
    date when it changes.
  </p>

  {/* Always rendered, and sticky: shown only on selection it shifted every band down the
      moment you clicked one, which moves the chip out from under the cursor, and a reader who
      clicked something in depth 7 got an answer written off the top of the screen. */}
  <div class="bands-readout sticky top-14 z-10 text-sm border border-gray-200 dark:border-gray-700 rounded-lg px-4 py-3 mb-4 bg-white dark:bg-[#0f0f0f]">
    <span class="bands-readout-name font-mono text-[13px] text-gray-900 dark:text-gray-100">nothing selected</span>
    <span class="bands-readout-body block text-gray-600 dark:text-gray-400 leading-snug mt-0.5">Pick a layer to see what feeds it, and what falls out of date when it changes.</span>
    <button class="bands-clear mt-2 font-mono text-[11px] text-amber-700 dark:text-amber-400 bg-transparent border-0 p-0 cursor-pointer" hidden>clear</button>
  </div>

  {bands.map(b => (
    <div class="band flex gap-4 py-3 border-t border-gray-100 dark:border-gray-800">
      <div class="band-rail w-14 flex-shrink-0 pt-1">
        <span class="block text-[10px] font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500">
          depth {b.depth}
        </span>
        <span class="block text-[10px] font-mono text-gray-300 dark:text-gray-600 tabular-nums">
          {b.layers.length}
        </span>
      </div>

      {/* Auto-fill grid rather than wrapped flex: the chips line up into columns instead of
          ragging, and the track count follows the width — four on a desktop, two on a phone —
          without a breakpoint anywhere. */}
      <div class="band-chips grid gap-2 min-w-0 flex-1">
        {b.layers.map(l => (
          <button class="chip map-node rounded px-2.5 py-2 text-left cursor-pointer min-w-0"
                  data-layer={l.id}
                  data-scope={l.scope}
                  data-needs={l.needs.join(' ')}
                  data-title={l.title}
                  title={l.question}>
            <span class="block font-mono text-[11.5px] leading-tight truncate">{l.id}</span>
            <span class="map-node-muted block text-[10px] leading-tight truncate">
              {l.kind}{l.group ? ` · ${l.group}` : ''}
              {l.open ? ' · undecided' : ''}
            </span>
            {l.scope === 'corpus' ? (
              <span class="map-node-muted block text-[9.5px] mt-1">every paper</span>
            ) : (
              <span class="flex items-center gap-1.5 mt-1">
                <span class="flex-1 h-1 rounded-full overflow-hidden" style={{ background: 'var(--st-absent)' }}>
                  <span class="block h-full" style={`width:${pct(l)}%;background:var(--st-current)`} />
                </span>
                <span class="map-node-muted text-[9.5px] tabular-nums">{l.fill?.done}/{l.fill?.total}</span>
              </span>
            )}
          </button>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .band-chips { grid-template-columns: repeat(auto-fill, minmax(152px, 1fr)); }

  /* Marking is opacity and a ring, not colour: the chips already carry state colour in the
     fill bar and the corpus-scope border, and a second colour system on top of that one is
     how the old map ended up needing a legend for its legend. */
  .bands[data-selected] .chip { opacity: 0.3; }
  .bands[data-selected] .chip[data-mark] { opacity: 1; }
  .chip[data-mark='self'] { outline: 2px solid var(--map-ring); outline-offset: 1px; }
  .chip[data-mark='needs'] { border-color: var(--map-ring); }
  .chip[data-mark='downstream'] { border-color: color-mix(in srgb, var(--map-ring) 45%, transparent); }
  .chip[data-mark='downstream'] .map-node-muted { opacity: 0.85; }
</style>

<script>
  // Selection is a class of its own rather than a framework: the whole interaction is a set
  // membership test over twenty-eight ids, and the page it lives on has no other state.
  document.querySelectorAll<HTMLElement>('.bands').forEach(root => {
    const needs: Record<string, string[]> = JSON.parse(root.dataset.edges || '{}');
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.chip'));
    const name = root.querySelector<HTMLElement>('.bands-readout-name')!;
    const body = root.querySelector<HTMLElement>('.bands-readout-body')!;
    const clearBtn = root.querySelector<HTMLElement>('.bands-clear')!;
    const IDLE: [string, string] = [
      'nothing selected',
      'Pick a layer to see what feeds it, and what falls out of date when it changes.',
    ];

    // Everything that would have to run again if this layer's answer changed. Breadth-first
    // over the reversed edges, which is the question the arrows in the old graph could only
    // answer by tracing.
    const downstreamOf = (id: string) => {
      const out = new Set<string>();
      const queue = [id];
      while (queue.length) {
        const cur = queue.shift()!;
        for (const [other, deps] of Object.entries(needs)) {
          if (deps.includes(cur) && !out.has(other)) { out.add(other); queue.push(other); }
        }
      }
      return out;
    };

    const clear = () => {
      delete root.dataset.selected;
      chips.forEach(c => { delete c.dataset.mark; c.setAttribute('aria-pressed', 'false'); });
      [name.textContent, body.textContent] = IDLE;
      clearBtn.hidden = true;
    };

    const select = (id: string) => {
      const direct = needs[id] ?? [];
      const down = downstreamOf(id);
      root.dataset.selected = id;
      chips.forEach(c => {
        const cid = c.dataset.layer!;
        const mark = cid === id ? 'self'
          : direct.includes(cid) ? 'needs'
          : down.has(cid) ? 'downstream'
          : null;
        if (mark) c.dataset.mark = mark; else delete c.dataset.mark;
        c.setAttribute('aria-pressed', String(cid === id));
      });
      name.textContent = id;
      const rests = direct.length ? `rests on ${direct.join(', ')}` : 'rests on nothing — it is a root';
      const falls = down.size
        ? `${down.size} layer${down.size === 1 ? '' : 's'} fall out of date if it changes`
        : 'nothing downstream of it';
      body.textContent = `${rests}. ${falls}.`;
      clearBtn.hidden = false;
    };

    chips.forEach(c => c.addEventListener('click', () => {
      if (root.dataset.selected === c.dataset.layer) clear(); else select(c.dataset.layer!);
    }));
    root.querySelector('.bands-clear')?.addEventListener('click', clear);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') clear(); });
  });
</script>
