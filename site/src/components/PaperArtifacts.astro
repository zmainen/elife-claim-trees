---
// What this paper produced, as something a reader can do something with.
//
// The tab used to be a list of links: every path a layer declares, rendered as a download
// where public/ held it and as a GitHub link otherwise. Two things were wrong with that. A
// declared path is not a file — most of them name output of a layer that has never run for
// that paper, and those were linked to a branch that does not contain them. And for the few
// that were real, the only gesture was leaving the site, including for the several formats
// this site already renders better than a raw download does.
//
// So each row now says which of four things it is — a file the site serves, a file only the
// repository has, a set of files, or something never produced — and offers what that permits:
// the site's own view of it, the bytes on the clipboard, the JSON read in place.
//
// Grouped by where each artifact came from. The sections are the groups layers.yaml declares;
// the ten layers between induction and interchange declare none, and are collected under a
// heading that says so rather than under a group invented here — a group in that file is a
// layer with children, not a display convention.
import { cells, groups as layerGroups, STATE_LABEL, STATE_NOTE } from '../lib/pipeline';
import { artifacts, isDirectory, SIZE, type Artifact } from '../lib/artifacts';

interface Props { paper: string }
const { paper } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rows = cells(paper)
  .map(c => ({
    cell: c,
    files: artifacts((c.produces ?? []).filter(p => !isDirectory(p)), base,
                     { paper, layer: c.layer.id }),
    dirs: (c.produces ?? []).filter(isDirectory),
  }))
  .filter(r => r.files.length > 0 || r.dirs.length > 0);

const all = rows.flatMap(r => r.files);
const served = all.filter(a => a.state === 'served');
const sets = all.filter(a => a.state === 'set');
const absent = all.filter(a => a.state === 'absent');
const elsewhere = all.filter(a => a.state === 'repo');

// Sections, in the order the layers appear — which is dependency order, so induction comes
// before what it feeds. `null` collects the layers that declare no group.
const UNGROUPED = {
  title: 'The claim tree, and what was measured against it',
  question: 'Layers that declare no group of their own.',
};
const sections: Array<{ key: string; title: string; question: string; rows: typeof rows }> = [];
for (const r of rows) {
  const key = r.cell.layer.group ?? '';
  let s = sections.find(x => x.key === key);
  if (!s) {
    const g = key ? layerGroups[key] : undefined;
    s = { key, title: g?.title ?? UNGROUPED.title, question: g?.question ?? UNGROUPED.question, rows: [] };
    sections.push(s);
  }
  s.rows.push(r);
}

const KIND_LABEL: Record<string, string> = {
  jsonld: 'JSON-LD', json: 'JSON', markdown: 'Markdown', image: 'image', code: 'source', other: 'file',
};
const TONE: Record<string, string> = {
  current: 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40',
  stale: 'text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40',
  blocked: 'text-orange-700 dark:text-orange-400 bg-orange-50 dark:bg-orange-950/40',
  absent: 'text-gray-500 dark:text-gray-500 bg-gray-100 dark:bg-gray-800',
  'n/a': 'text-gray-500 dark:text-gray-500 bg-gray-100 dark:bg-gray-800',
  open: 'text-blue-700 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40',
  unrecorded: 'text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800/70',
};

// What a row says about itself, under the filename.
const describe = (a: Artifact) =>
  a.state === 'absent'
    ? 'Not produced — this layer has not run for this paper.'
    : a.state === 'set'
      ? `${a.count} file${a.count === 1 ? '' : 's'} — a set, not a download.`
      : [KIND_LABEL[a.kind] + (a.note ? ` — ${a.note}` : ''),
         SIZE(a.bytes), a.state === 'repo' ? 'in the repository' : null]
        .filter(Boolean).join(' · ');
---

<section>
  <p class="text-sm text-gray-600 dark:text-gray-400 max-w-2xl mb-1">
    Every file the pipeline produced for this paper, from the <code class="text-[12.5px]">produces</code>
    each layer declares. {served.length} are served here — copy or read any of them in place;
    {sets.length} are sets of files the site renders as pages;
    {absent.length} name output of a layer that has not run{elsewhere.length > 0
      ? `, and ${elsewhere.length} exist only in the repository` : ''}.
  </p>
  <p class="text-xs text-gray-500 dark:text-gray-500 mb-7">
    Each cell is also addressable as JSON at <code class="text-[11.5px]">/data/{paper}/&lt;layer&gt;.json</code>.
  </p>

  {rows.length === 0 ? (
    <p class="text-sm text-gray-500 dark:text-gray-400">
      No layer has produced a file for this paper yet.
    </p>
  ) : sections.map(sec => (
    <div class="mb-9">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-gray-300 dark:border-gray-600 pb-1.5 mb-3.5">
        <h3 class="text-[15px] font-semibold text-gray-900 dark:text-gray-100 m-0">{sec.title}</h3>
        <span class="text-[12px] italic text-gray-500 dark:text-gray-400">{sec.question}</span>
        <span class="ml-auto text-[11px] font-mono text-gray-400 dark:text-gray-500 tabular-nums">
          {sec.rows.length} layer{sec.rows.length === 1 ? '' : 's'}
        </span>
      </div>

      <div class="space-y-3">
        {sec.rows.map(({ cell: c, files, dirs }) => (
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <a href={c.href}
                 class="font-mono text-[13px] text-gray-900 dark:text-gray-100 no-underline border-b border-gray-300 dark:border-gray-600 hover:text-amber-700 dark:hover:text-amber-400 hover:border-amber-700">
                {c.layer.id}
              </a>
              <span class={`text-[10px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded ${TONE[c.state]}`}
                    title={STATE_NOTE[c.state]}>
                {STATE_LABEL[c.state]}
              </span>
              <span class="text-[11px] font-mono text-gray-400 dark:text-gray-500">
                {c.v ? `v${c.v}` : ''}{c.ran ? ` · ${c.ran.slice(0, 10)}` : ''}
              </span>
              <a href={c.dataHref}
                 class="ml-auto text-[11px] font-mono text-gray-400 dark:text-gray-500 no-underline hover:text-amber-700 dark:hover:text-amber-400">
                cell as JSON ↗
              </a>
            </div>
            <p class="text-[12.5px] italic text-gray-500 dark:text-gray-400 m-0 mb-3 leading-snug">{c.layer.question}</p>

            <ul class="list-none p-0 m-0">
              {files.map(a => (
                <li class="py-2 border-t border-dotted border-gray-200 dark:border-gray-700 first:border-t-0 first:pt-0">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1.5">
                    <div class="min-w-0">
                      {a.href ? (
                        <a href={a.href} download
                           class="font-mono text-[12px] text-amber-700 dark:text-amber-400 no-underline hover:underline leading-snug"
                           style="overflow-wrap:anywhere">{a.name}</a>
                      ) : (
                        <span class="font-mono text-[12px] text-gray-400 dark:text-gray-500 leading-snug"
                              style="overflow-wrap:anywhere">{a.path}</span>
                      )}
                      <span class="block text-[11px] text-gray-500 dark:text-gray-400 leading-snug">
                        {describe(a)}
                      </span>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0">
                      {a.views.map(v => (
                        <a href={v.href}
                           class="font-mono text-[10.5px] no-underline px-2 py-[3px] rounded border border-amber-600/60 text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 hover:bg-amber-100 dark:hover:bg-amber-900/50">
                          {v.label}
                        </a>
                      ))}
                      {a.downloadable && a.kind !== 'image' && (
                        <button type="button" data-preview={a.href} aria-expanded="false"
                                class="font-mono text-[10.5px] px-2 py-[3px] rounded border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:border-amber-600 hover:text-amber-700 dark:hover:text-amber-400 cursor-pointer">
                          preview
                        </button>
                      )}
                      {a.downloadable && (
                        <button type="button" data-copy={a.href}
                                class="font-mono text-[10.5px] px-2 py-[3px] rounded border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:border-amber-600 hover:text-amber-700 dark:hover:text-amber-400 cursor-pointer">
                          copy
                        </button>
                      )}
                      {a.state === 'repo' && a.source && (
                        <a href={a.source} target="_blank" rel="noopener"
                           class="font-mono text-[10.5px] no-underline px-2 py-[3px] rounded border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:border-amber-600 hover:text-amber-700 dark:hover:text-amber-400">
                          on GitHub ↗
                        </a>
                      )}
                      {a.state === 'set' && a.source && (
                        <a href={a.source.replace('/blob/', '/tree/').replace(/\/[^/]*\*[^/]*$/, '')}
                           target="_blank" rel="noopener"
                           class="font-mono text-[10.5px] no-underline px-2 py-[3px] rounded border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:border-amber-600 hover:text-amber-700 dark:hover:text-amber-400">
                          on GitHub ↗
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              ))}
              {dirs.map(d => (
                <li class="py-2 border-t border-dotted border-gray-200 dark:border-gray-700 first:border-t-0 first:pt-0 text-[11.5px] text-gray-500 dark:text-gray-400">
                  <code class="text-[11px]">{d}</code> — a directory of files, not a single download
                </li>
              ))}
            </ul>

            {/* The command is the answer to a row that says "not produced", and it is already
                declared — so it is here rather than one page away. */}
            {c.state === 'absent' && c.command && (
              <details class="mt-2">
                <summary class="text-[11px] font-mono text-gray-400 dark:text-gray-500 cursor-pointer hover:text-amber-700 dark:hover:text-amber-400">
                  what would produce it
                </summary>
                <pre class="mt-1.5 mb-0 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded p-2.5 text-[11px] text-gray-700 dark:text-gray-300 overflow-x-auto"><code>python3 scripts/pipeline.py run {paper} {c.layer.id}</code></pre>
              </details>
            )}
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<script>
  // Copy and preview, on the artifacts the site actually serves.
  //
  // Fetched when asked for rather than inlined: the MIRA export alone is 75 KB per paper, and
  // a tab that shipped every artifact in its HTML would be several megabytes to read one.
  const bytes = new Map<string, string>();
  const inflight = new Map<string, Promise<string>>();
  const text = (url: string): Promise<string> => {
    const got = bytes.get(url);
    if (got !== undefined) return Promise.resolve(got);
    if (!inflight.has(url)) inflight.set(url, fetch(url)
      .then(r => { if (!r.ok) throw new Error(String(r.status)); return r.text(); })
      .then(t => { bytes.set(url, t); return t; }));
    return inflight.get(url)!;
  };

  // Fetched when the pointer or the keyboard reaches the button, not when it is pressed: a
  // clipboard write that happens after an await has lost the click's transient activation,
  // and Safari and Firefox refuse it. Warming means the write itself is synchronous.
  for (const ev of ['pointerenter', 'focus'] as const) {
    document.addEventListener(ev, e => {
      const el = (e.target as HTMLElement)?.closest?.('button[data-copy], button[data-preview]');
      const d = (el as HTMLButtonElement | null)?.dataset;
      const url = d?.copy ?? d?.preview;
      if (url) text(url).catch(() => { /* the click will report it */ });
    }, true);
  }

  // Some browsers refuse the async clipboard outright — the permission is denied, or the page
  // is in an embedded view that never had it. The selection-based copy predates the API, needs
  // no permission, and is the difference between a button that works there and one that does
  // not.
  const write = (s: string): Promise<unknown> =>
    navigator.clipboard.writeText(s).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = s;
      ta.setAttribute('style', 'position:fixed;top:0;left:0;opacity:0');
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok ? undefined : Promise.reject(new Error('refused'));
    });

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // A JSON tree, collapsible. <details> rather than a click handler per node, so a reader can
  // open one branch with the keyboard and the browser keeps the state.
  //
  // A closed node carries a name as well as a count. Without one, `@graph` in a MIRA export
  // is 151 rows reading `{10}` — the shape of the file and nothing about its contents, which
  // is the opposite of what a reader opened it for.
  const NAMES = ['@id', 'id', 'slug', 'label', 'title', 'name', '@type', 'claim', 'path', 'layer'];
  const nameOf = (o: Record<string, unknown>) => {
    for (const k of NAMES) {
      const v = o[k];
      if (typeof v === 'string' && v) return v.length > 72 ? v.slice(0, 72) + '…' : v;
    }
    return '';
  };

  // The label a node is introduced by — its key, or its index in an array — sits inside the
  // summary rather than beside it, so a closed branch is one line rather than two.
  const OPEN_TO = 2;
  function tree(v: unknown, depth = 0, label = ''): string {
    if (v === null || typeof v !== 'object') {
      const cls = typeof v === 'string' ? 'a-str' : typeof v === 'number' ? 'a-num' : 'a-lit';
      return `${label}<span class="${cls}">${esc(JSON.stringify(v))}</span>`;
    }
    const arr = Array.isArray(v);
    const entries = Object.entries(v as Record<string, unknown>);
    if (entries.length === 0) return `${label}<span class="a-lit">${arr ? '[]' : '{}'}</span>`;
    const rows = entries.map(([k, val], i) => `<li>${tree(val, depth + 1,
      arr ? `<span class="a-idx">${i}</span> ` : `<span class="a-key">${esc(k)}</span>: `)}</li>`
    ).join('');
    const count = arr ? `[${entries.length}]` : `{${entries.length}}`;
    const name = arr ? '' : nameOf(v as Record<string, unknown>);
    return `<details${depth < OPEN_TO ? ' open' : ''}><summary>${label}<span class="a-count">${count}</span>${
      name ? ` <span class="a-name">${esc(name)}</span>` : ''}</summary><ul>${rows}</ul></details>`;
  }

  function render(url: string, body: string): string {
    if (/\.(json|jsonld)$/.test(url)) {
      try { return `<div class="a-json">${tree(JSON.parse(body))}</div>`; }
      catch { /* an unparseable artifact is still worth showing as text */ }
    }
    const head = body.length > 40000 ? body.slice(0, 40000) : body;
    return `<pre class="a-text">${esc(head)}</pre>${
      head.length < body.length ? '<p class="a-more">Shown to 40 KB. Download for the rest.</p>' : ''}`;
  }

  document.addEventListener('click', async e => {
    const el = (e.target as HTMLElement).closest('button') as HTMLButtonElement | null;
    if (!el) return;

    const copyUrl = el.dataset.copy;
    if (copyUrl) {
      const said = el.textContent;
      const done = (ok: boolean) => {
        el.textContent = ok ? 'copied' : 'copy failed';
        setTimeout(() => { el.textContent = said; }, 1800);
      };
      const warm = bytes.get(copyUrl);
      (warm !== undefined
        ? write(warm)
        : text(copyUrl).then(write)
      ).then(() => done(true), () => done(false));
      return;
    }

    const previewUrl = el.dataset.preview;
    if (!previewUrl) return;
    const row = el.closest('li')!;
    let panel = row.querySelector<HTMLElement>('.a-preview');
    if (panel) {
      const open = panel.hidden;
      panel.hidden = !open;
      el.setAttribute('aria-expanded', String(open));
      el.textContent = open ? 'hide' : 'preview';
      return;
    }
    panel = document.createElement('div');
    panel.className = 'a-preview';
    panel.textContent = 'reading…';
    row.appendChild(panel);
    el.setAttribute('aria-expanded', 'true');
    el.textContent = 'hide';
    try {
      panel.innerHTML = render(previewUrl, await text(previewUrl));
    } catch (err) {
      panel.textContent = `Could not read it: ${(err as Error).message}`;
    }
  });
</script>

<style is:global>
  /* The preview is built by the script above, so these cannot be scoped styles: Astro's
     scoping stamps an attribute on server-rendered elements, and nothing in here is one.
     Every selector is under .a-preview, which exists nowhere else. */
  .a-preview {
    margin-top: 0.6rem;
    border: 1px solid var(--card-border);
    border-radius: 4px;
    background: var(--card-sunk);
    padding: 0.7rem 0.85rem;
    max-height: 26rem;
    overflow: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--card-body);
  }
  .a-preview ul { list-style: none; margin: 0; padding-left: 1rem; border-left: 1px solid var(--card-border); }
  .a-preview li { white-space: pre-wrap; overflow-wrap: anywhere; }
  .a-preview summary { cursor: pointer; color: var(--card-muted); }
  .a-preview summary:hover { color: #b45309; }
  .a-preview .a-key { color: #b45309; }
  .a-preview .a-str { color: #15803d; }
  .a-preview .a-num { color: #1d4ed8; }
  .a-preview .a-lit, .a-preview .a-count, .a-preview .a-idx { color: var(--card-faint); }
  .a-preview .a-name { color: var(--card-strong); }
  .a-preview .a-text { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .a-preview .a-more { margin: 0.5rem 0 0; font-size: 10.5px; color: var(--card-muted); }
  html.dark .a-preview summary:hover { color: #fbbf24; }
  html.dark .a-preview .a-key { color: #fbbf24; }
  html.dark .a-preview .a-str { color: #6ee7a8; }
  html.dark .a-preview .a-num { color: #93c5fd; }
</style>
