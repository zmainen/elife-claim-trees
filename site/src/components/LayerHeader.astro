---
// The head of a layer page: what it asks, what kind of thing it is, where it sits in the
// graph, and what it found.
//
// A component rather than markup in the template, because a few layers earn a page of their
// own — MIRA has schema requirements no generic view can generate — and those pages should
// carry the same head as the rest rather than reinventing it. A bespoke page is depth behind
// the general surface, not an escape from it.
import { byId, groups, dependents, resolve, type LayerDecl } from '../lib/pipeline';

interface Props { layer: LayerDecl }
const { layer } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}/`;
const feeds = dependents(layer.id);
const needs = (layer.needs ?? []).map(n => byId[n]).filter(Boolean);

const KIND_NOTE: Record<string, string> = {
  step: 'Mechanical: re-runnable from its declared inputs.',
  candidate: 'One of several parallel outputs, kept rather than collapsed — agreement between them is the informative case.',
  judgement: 'A decision, stored rather than recomputed, because recomputing it destroys the record of who decided.',
  feature: 'A capability that revises existing artifacts. It runs once, and then it is part of the schema.',
  question: 'A decision about meaning, and then the propagation of it through everything downstream.',
};
const code = (s: string) => s.replace(/`([^`]+)`/g, '<code class="text-[13px]">$1</code>');
---

<nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
  <a href={url('/pipeline')} class="text-amber-700 dark:text-amber-400 no-underline hover:underline">Pipeline</a>
  <span class="mx-2">/</span><span class="font-mono">{layer.id}</span>
</nav>

<header class="mb-9">
  <div class="flex flex-wrap items-baseline gap-3 mb-2">
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-gray-100 tracking-tight m-0">{layer.title}</h1>
    <span class="font-mono text-xs text-gray-500 dark:text-gray-400">{layer.kind} · {layer.scope}</span>
    {layer.open && <span class="text-xs font-mono uppercase tracking-wider text-blue-700 dark:text-blue-400">undecided</span>}
    {layer.requires_human && <span class="text-xs font-mono uppercase tracking-wider text-amber-700 dark:text-amber-400">needs a person</span>}
  </div>
  <p class="text-lg text-gray-700 dark:text-gray-300 italic m-0 mb-3 leading-snug">{layer.question}</p>
  <p class="text-sm text-gray-600 dark:text-gray-400 m-0">{KIND_NOTE[layer.kind]}</p>
  {layer.group && groups[layer.group] && (
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2 m-0">
      Part of <strong class="text-gray-700 dark:text-gray-300">{groups[layer.group].title}</strong> — {groups[layer.group].question}
    </p>
  )}
  {layer.issue && (
    <p class="text-sm mt-3 m-0">
      <a href={`https://github.com/zmainen/elife-claim-trees/issues/${layer.issue}`} target="_blank"
         class="text-amber-700 dark:text-amber-400 no-underline hover:underline">Issue #{layer.issue}</a>
      <span class="text-gray-500 dark:text-gray-400"> — the decision is taken there; the propagation is taken here.</span>
    </p>
  )}
</header>

{layer.found && (
  <section class="mb-10 border-l-2 border-emerald-500 dark:border-emerald-600 pl-4">
    <h2 class="text-[10px] font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500 m-0 mb-2">
      What it found{layer.added ? ` · added ${layer.added}` : ''}
    </h2>
    <p class="text-[15px] text-gray-700 dark:text-gray-300 m-0 leading-relaxed max-w-2xl"
       set:html={code(resolve(layer.found))}></p>
  </section>
)}

<div class="grid sm:grid-cols-2 gap-5 mb-10">
  <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
    <h2 class="text-[10px] font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500 m-0 mb-2.5">Rests on</h2>
    {needs.length === 0
      ? <p class="text-sm text-gray-500 dark:text-gray-400 m-0">Nothing — this is a root.</p>
      : <ul class="list-none p-0 m-0 space-y-1">
          {needs.map(n => (
            <li><a href={url(`/pipeline/${n.id}`)} class="font-mono text-sm text-amber-700 dark:text-amber-400 no-underline hover:underline">{n.id}</a>
              <span class="text-xs text-gray-500 dark:text-gray-400"> · {n.kind}</span></li>
          ))}
        </ul>}
  </div>
  <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
    <h2 class="text-[10px] font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500 m-0 mb-2.5">
      Feeds {feeds.length > 0 && <span class="normal-case tracking-normal">— a change here disturbs these</span>}
    </h2>
    {feeds.length === 0
      ? <p class="text-sm text-gray-500 dark:text-gray-400 m-0">Nothing — this is a leaf.</p>
      : <ul class="list-none p-0 m-0 space-y-1">
          {feeds.map(n => (
            <li><a href={url(`/pipeline/${n.id}`)} class="font-mono text-sm text-amber-700 dark:text-amber-400 no-underline hover:underline">{n.id}</a>
              <span class="text-xs text-gray-500 dark:text-gray-400"> · {n.kind}</span></li>
          ))}
        </ul>}
  </div>
</div>

{layer.reviews && (
  <div class="border-l-2 border-amber-400 dark:border-amber-600 pl-4 mb-10">
    <p class="text-sm text-gray-700 dark:text-gray-300 m-0 leading-relaxed">
      This layer reviews <a href={url(`/pipeline/${layer.reviews}`)} class="font-mono text-amber-700 dark:text-amber-400 no-underline hover:underline">{layer.reviews}</a>,
      and a review targets the version it read. When {layer.reviews} produces a new version this
      one goes stale rather than carrying an approval earned against different text.
    </p>
  </div>
)}
