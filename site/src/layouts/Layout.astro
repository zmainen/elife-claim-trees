---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Panel-level claim graphs for reproducibility — eLife Claim Trees' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}/`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — eLife Claim Trees</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    // One theme selector: the `dark` class, which is what global.css and every `dark:`
    // utility key on. There were two — Starlight stamped `data-theme` and this stamped both,
    // so the site agreed with the docs by writing the preference twice. Starlight is gone and
    // so is the duplicate. The old key is still read once, so a visitor who set a preference
    // under it keeps it.
    (function() {
      var stored = localStorage.getItem('theme') || localStorage.getItem('starlight-theme');
      var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (theme === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    font-family: Inter, system-ui, sans-serif;
  }
  .badge-gold       { background: #d97706; color: #fff; }
  .badge-silver     { background: #64748b; color: #fff; }
  .badge-compute    { background: #374151; color: #9ca3af; border: 1px solid #4b5563; }
  .badge-gap        { background: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b; }
  .badge-structural { background: #374151; color: #9ca3af; border: 1px solid #4b5563; }
  .badge-pending    { background: #f3f4f6; color: #6b7280; border: 1px solid #d1d5db; }

  /* Dark mode overrides for non-Tailwind elements */
  html.dark .badge-pending {
    background: #1f2937; color: #9ca3af; border-color: #374151;
  }
</style>
</head>
<body class="min-h-screen bg-white dark:bg-[#0f0f0f] text-gray-900 dark:text-gray-100 transition-colors">
  <nav class="border-b border-gray-100 dark:border-gray-800 bg-white dark:bg-[#0f0f0f] sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-12 flex items-center gap-6">
      <a href={url('')} class="font-semibold text-gray-900 dark:text-gray-100 no-underline hover:text-gray-700 dark:hover:text-gray-300 text-sm flex-shrink-0">Claims</a>
      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-6">
        <a href={url('/papers')} class="text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200">Papers</a>
        <a href={url('/pipeline')} class="text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200">Pipeline</a>
        <a href={url('/docs')} class="text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200">Docs</a>
        <a href={url('/standards')} class="text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200">Standards</a>
      </div>
      <div class="flex-1"></div>
      <button id="theme-toggle" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-sm cursor-pointer" aria-label="Toggle theme">
        <span class="dark:hidden">&#9790;</span>
        <span class="hidden dark:inline">&#9788;</span>
      </button>
      <!-- Hamburger -->
      <button id="menu-toggle" class="md:hidden text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 cursor-pointer" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-[#0f0f0f] px-4 py-3 space-y-2">
      <a href={url('/papers')} class="block text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200 py-1">Papers</a>
      <a href={url('/pipeline')} class="block text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200 py-1">Pipeline</a>
      <a href={url('/docs')} class="block text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200 py-1">Docs</a>
      <a href={url('/standards')} class="block text-sm text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-200 py-1">Standards</a>
    </div>
  </nav>
  <script is:inline>
    document.getElementById('menu-toggle')?.addEventListener('click', function() {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
  </script>
  <main>
    <slot />
  </main>
  <script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', function() {
      var isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  </script>
</body>
</html>
