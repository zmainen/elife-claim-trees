---
// Retired into /pipeline/formats-report.
//
// The comparison is what one layer of the pipeline produces, so it belongs on that layer's
// page rather than at a top-level URL of its own. The per-paper comparison stays at
// /formats/<paper> until the paper page carries its layers.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/pipeline/formats-report/`, 301);
---
