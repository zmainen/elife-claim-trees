---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import corpus from '../../data/claims.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}/`;

// The numbers come from the same artifact the per-paper pages render —
// `exports/<slug>.formats.json`, which formats_report.py writes alongside the
// Markdown, explicitly so a page can render the numbers without restating them.
const exportsDir = join(process.cwd(), '..', 'exports');
type Row = {
  slug: string; title: string; claims: number; relations: number;
  miraKept: number; miraLost: number; inverseOnly: number;
  inheritsCore: number; neutral: number; oxa: number; dg: number;
};

const rows: Row[] = corpus.papers.flatMap((p: any) => {
  const f = join(exportsDir, `${p.slug}.formats.json`);
  if (!existsSync(f)) return [];
  const r = JSON.parse(readFileSync(f, 'utf-8'));
  return [{
    slug: p.slug,
    title: p.title,
    claims: r.claims,
    relations: r.relations,
    miraKept: r.mira.kept,
    miraLost: r.mira.lost,
    inverseOnly: Object.values(r.mira.inverse_only ?? {}).reduce((a: number, b: any) => a + b, 0),
    inheritsCore: r.mira.inherits_core,
    neutral: r.mira.neutral,
    oxa: r.oxa.kept,
    dg: r.dg.kept,
  }];
});

const total = <T extends keyof Row>(k: T) => rows.reduce((s, r) => s + (r[k] as number), 0);
const totals = {
  claims: total('claims'), relations: total('relations'),
  miraLost: total('miraLost'), inheritsCore: total('inheritsCore'),
  neutral: total('neutral'), oxa: total('oxa'), dg: total('dg'),
};
const pct = (n: number, d: number) => (d ? Math.round((100 * n) / d) : 0);

// Gädeke is the worked example throughout the repository.
const featured = rows.find(r => r.slug === 'gadeke-2026-guilt-insula') ?? rows[0];
---

<Layout title="Formats" description="What each interchange format carries from a claim tree, and what it drops — measured from the generated exports.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">

    <h1 class="text-3xl font-semibold text-gray-900 dark:text-gray-100 tracking-tight mb-8">
      What each format carries
    </h1>

    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-10">
      <p>
        A claim tree is a set of typed claims with typed relations between them. Three interchange formats can hold some version of that — <strong>MIRA</strong>, the discourse-graph schema eLife's article platform reads; <strong>OXA</strong>, the open document architecture; and <strong>Discourse Graphs</strong> JSON-LD. Each one keeps a different part, and the interesting question is not which is best but what each conversion costs.
      </p>
      <p>
        These pages answer that per paper, and they answer it by <em>measuring the generated exports</em> rather than by reading the converters' mapping tables. A mapping table says what a converter intends. The export says what it did, and those are not the same thing.
      </p>
    </div>

    <div class="border-l-2 border-amber-400 dark:border-amber-600 pl-4 mb-12">
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
        This distinction is not hypothetical. The comparison first reported that <span class="line-through">MIRA drops 57%</span> of this corpus's relations, and later that <span class="line-through">MIRA drops 100%</span> of them. Both were facts about our own measuring code — the first counted a declared relation as a dropped one, the second looked for edges as node properties after the exporter had moved to MIRA's reified encoding. MIRA had not changed between the two. Neither had the corpus.
      </p>
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mt-3">
        So the page you are reading renders <code class="text-xs">exports/&lt;slug&gt;.formats.md</code> directly. There is no second copy of these numbers to drift.
      </p>
    </div>

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Across the corpus</h2>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">{totals.relations}</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">typed relations in the trees</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">{totals.miraLost}</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">lost in the strict MIRA export</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">{pct(totals.neutral, totals.relations)}%</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">neither support nor opposition</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">0</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">formats with a verification node</div>
      </div>
    </div>

    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-8">
      <p>
        The middle two numbers are the ones worth separating. A relation that is <em>neither support nor opposition</em> — <code class="text-xs">scopes</code>, <code class="text-xs">entails</code>, <code class="text-xs">requires</code> — is not dropped by MIRA and not flattened into <code class="text-xs">supports</code>. MIRA imports a Discourse Graphs base schema in which relations are definable, and its <code class="text-xs">AbstractRelationDef</code> is a neutral root, so each such relation is declared in the document with a domain, a range and a description, and the edges are typed by that declaration. A reader who follows only core MIRA sees an edge and learns that it is neither supporting nor opposing, which is true.
      </p>
      <p>
        What is genuinely lost is narrower: relations whose target is <code class="text-xs">*</code>, meaning the claim constrains the paper as a whole rather than another claim. MIRA has no paper-level node for those to point at, so no edge is emitted and none is invented. Each paper's <code class="text-xs">gap-report.md</code> names them.
      </p>
      <p>
        And one thing no format carries at all: <strong>verification</strong> — that a claim was checked, by what code, against what deposited data, with what result beside the published value. None of the three has a node for it.
      </p>
    </div>

    <div class="overflow-x-auto mb-4">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-700 text-left">
            <th class="py-2 pr-4 font-medium text-gray-500 dark:text-gray-400">Paper</th>
            <th class="py-2 px-2 font-medium text-gray-500 dark:text-gray-400 text-right">Claims</th>
            <th class="py-2 px-2 font-medium text-gray-500 dark:text-gray-400 text-right">Relations</th>
            <th class="py-2 px-2 font-medium text-gray-500 dark:text-gray-400 text-right">MIRA lost</th>
            <th class="py-2 px-2 font-medium text-gray-500 dark:text-gray-400 text-right">OXA</th>
            <th class="py-2 pl-2 font-medium text-gray-500 dark:text-gray-400 text-right">DG</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(r => (
            <tr class="border-b border-gray-100 dark:border-gray-800">
              <td class="py-2 pr-4">
                <a href={url(`/formats/${r.slug}`)} class="text-amber-700 dark:text-amber-400 hover:underline">{r.slug}</a>
              </td>
              <td class="py-2 px-2 text-right tabular-nums text-gray-700 dark:text-gray-300">{r.claims}</td>
              <td class="py-2 px-2 text-right tabular-nums text-gray-700 dark:text-gray-300">{r.relations}</td>
              <td class={`py-2 px-2 text-right tabular-nums ${r.miraLost ? 'text-red-700 dark:text-red-400' : 'text-gray-400 dark:text-gray-500'}`}>{r.miraLost}</td>
              <td class="py-2 px-2 text-right tabular-nums text-gray-700 dark:text-gray-300">{r.oxa}</td>
              <td class="py-2 pl-2 text-right tabular-nums text-gray-700 dark:text-gray-300">{r.dg}</td>
            </tr>
          ))}
          <tr class="font-medium">
            <td class="py-2 pr-4 text-gray-900 dark:text-gray-100">{rows.length} papers</td>
            <td class="py-2 px-2 text-right tabular-nums text-gray-900 dark:text-gray-100">{totals.claims}</td>
            <td class="py-2 px-2 text-right tabular-nums text-gray-900 dark:text-gray-100">{totals.relations}</td>
            <td class="py-2 px-2 text-right tabular-nums text-gray-900 dark:text-gray-100">{totals.miraLost}</td>
            <td class="py-2 px-2 text-right tabular-nums text-gray-900 dark:text-gray-100">{totals.oxa}</td>
            <td class="py-2 pl-2 text-right tabular-nums text-gray-900 dark:text-gray-100">{totals.dg}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-xs text-gray-500 dark:text-gray-400 mb-12">
      Read from <code>exports/&lt;slug&gt;.formats.json</code>. The OXA and DG columns count the relations actually present in those exports, so a column that does not match the tree is either a mapping the format cannot express or an export left stale — the paper's page says which. Regenerate with <code>python3 scripts/formats_report.py --all</code>.
    </p>

    {featured && (
      <>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">Worked example</h2>
        <a href={url(`/formats/${featured.slug}`)} class="block p-5 border border-gray-200 dark:border-gray-700 rounded-xl hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group mb-12">
          <div class="text-sm font-medium text-gray-900 dark:text-gray-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mb-1">{featured.title}</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">
            {featured.claims} claims · {featured.relations} typed relations · {featured.inheritsCore} of {featured.miraKept} MIRA edges declared under <code>mira:supports</code> or <code>mira:opposes</code> · {featured.miraLost} lost
          </div>
        </a>
      </>
    )}

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">Every paper</h2>
    <div class="grid sm:grid-cols-2 gap-3 mb-12">
      {rows.map(r => (
        <a href={url(`/formats/${r.slug}`)} class="block p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group">
          <div class="text-sm text-gray-900 dark:text-gray-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 leading-snug mb-1">{r.title}</div>
          <div class="text-xs text-gray-500 dark:text-gray-400">{r.relations} relations · {r.miraLost} lost to MIRA</div>
        </a>
      ))}
    </div>

    <div class="text-sm text-gray-500 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800 pt-6">
      The argument for a Claim node in these standards is on the <a href={url('/standards')} class="text-amber-700 dark:text-amber-400 hover:underline">standards page</a>. How the exports are produced is in <a href={url('/docs/cli/first-paper')} class="text-amber-700 dark:text-amber-400 hover:underline">one paper end to end</a>.
    </div>

  </div>
</Layout>
