---
// Retired into /papers/<paper>/formats-report.
//
// The comparison is one layer's output for one paper, so it belongs on that cell rather than
// under a top-level /formats/ that no longer exists. The rendering — the artifact itself,
// rather than a restatement of it — moved with it.
import corpus from '../../data/claims.json';

export function getStaticPaths() {
  return (corpus as any).papers.map((p: any) => ({ params: { paper: p.slug } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/papers/${Astro.params.paper}/formats-report/`, 301);
---
