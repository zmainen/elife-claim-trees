---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import corpus from '../../data/claims.json';

export async function getStaticPaths() {
  const entries = await getCollection('formats');
  const published = new Map(
    (corpus.papers as any[]).map(p => [p.slug, p]),
  );
  return entries.flatMap(entry => {
    // The loader sets the entry id to the paper slug; the site publishes only
    // papers that have a page.
    const paper = published.get(entry.id);
    if (!paper) return [];
    return [{ params: { paper: entry.id }, props: { entry, paper } }];
  });
}

const { entry, paper } = Astro.props;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}/`;
const file = (name: string) => `${base}/exports/${name}`;

const downloads = [
  ['MD', `${paper.slug}.formats.md`, 'This comparison, as the exporter wrote it'],
  ['JSONLD', `${paper.slug}.mira.jsonld`, 'Strict MIRA core'],
  ['JSONLD', `${paper.slug}.mira-extended.jsonld`, 'MIRA plus what MIRA cannot carry'],
  ['MD', `${paper.slug}.gap-report.md`, 'What the strict export dropped'],
  ['JSON', `${paper.slug}.oxa.json`, 'The paper as one OXA Document'],
  ['JSONLD', `${paper.slug}.dg.jsonld`, 'Discourse Graphs JSON-LD'],
];
---

<Layout title={`Formats — ${paper.slug}`} description={`What MIRA, OXA and Discourse Graphs carry from the ${paper.slug} claim tree, measured from the generated exports.`}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">

    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      <a href={url('/formats')} class="text-amber-700 dark:text-amber-400 hover:underline">Formats</a>
      <span class="mx-2">/</span>
      <span>{paper.slug}</span>
    </nav>

    <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 tracking-tight leading-snug mb-2">{paper.title}</h1>
    <div class="text-sm text-gray-500 dark:text-gray-400 mb-8">
      {paper.authors?.join(', ')}{paper.journal ? ` · ${paper.journal}` : ''}
      {paper.doi && <span> · DOI: {paper.doi}</span>}
      <span class="mx-1">·</span>
      <a href={url(`/papers/${paper.slug}`)} class="text-amber-700 dark:text-amber-400 hover:underline">claim tree</a>
    </div>

    <!-- The artifact itself. Rendered, not restated: this is
         exports/<slug>.formats.md as scripts/formats_report.py wrote it. -->
    <article class="formats-report">
      <Content />
    </article>

    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mt-12 mb-3">The files this describes</h2>
    <div class="space-y-2">
      {downloads.map(([kind, name, what]) => (
        <a href={file(name)} class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group" target="_blank">
          <code class="text-xs text-amber-700 dark:text-amber-400 w-16 flex-shrink-0">{kind}</code>
          <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100">{what}</span>
        </a>
      ))}
    </div>

    <p class="text-xs text-gray-500 dark:text-gray-400 mt-8">
      Regenerate with <code>python3 scripts/export_mira.py {paper.slug}</code> then <code>python3 scripts/formats_report.py {paper.slug}</code>. The exports are byte-stable, so an empty <code>git diff</code> afterwards is a real check.
    </p>

  </div>
</Layout>

<style is:global>
  /* The report is generated Markdown, so it arrives as bare tags. Style it here
     rather than in the generator: the artifact stays a plain file that reads the
     same in a terminal, a diff and an editor. */
  .formats-report h1 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
    color: var(--fr-strong);
  }
  .formats-report h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--fr-rule);
    color: var(--fr-strong);
  }
  .formats-report p,
  .formats-report li {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--fr-body);
  }
  .formats-report p { margin: 0 0 1rem; }
  .formats-report ul { margin: 0 0 1rem; padding-left: 1.25rem; list-style: disc; }
  .formats-report li { margin-bottom: 0.25rem; }
  .formats-report strong { color: var(--fr-strong); font-weight: 600; }
  .formats-report code {
    font-size: 0.8125rem;
    background: var(--fr-code-bg);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
  .formats-report a { color: var(--fr-link); }
  .formats-report hr { margin: 2rem 0 1rem; border: 0; border-top: 1px solid var(--fr-rule); }
  /* The trailing provenance note. */
  .formats-report hr + p { font-size: 0.8125rem; color: var(--fr-muted); }

  /* Wide tables scroll rather than pushing the page sideways. */
  .formats-report table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    margin: 0 0 1.5rem;
  }
  .formats-report th,
  .formats-report td {
    padding: 0.4rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--fr-rule);
    white-space: nowrap;
  }
  .formats-report th { color: var(--fr-muted); font-weight: 500; }
  .formats-report td { color: var(--fr-body); }
  .formats-report td:nth-child(2) { text-align: right; font-variant-numeric: tabular-nums; }

  .formats-report {
    --fr-strong: #111827;
    --fr-body: #374151;
    --fr-muted: #6b7280;
    --fr-rule: #e5e7eb;
    --fr-code-bg: #f3f4f6;
    --fr-link: #b45309;
  }
  :root[data-theme='dark'] .formats-report {
    --fr-strong: #f3f4f6;
    --fr-body: #d1d5db;
    --fr-muted: #9ca3af;
    --fr-rule: #374151;
    --fr-code-bg: #1f2937;
    --fr-link: #fbbf24;
  }
</style>
