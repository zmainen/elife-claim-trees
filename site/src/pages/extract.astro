---
// Extract — the pipeline, run end to end on the worked example.
//
// This page used to be a UI for an extraction service, fetching console.haak.world and falling
// back to localhost. GitHub Pages serves static files, so it could never do anything here.
// It is now the real Gädeke run: the commands that produced the corpus, the artifact each one
// wrote, and the numbers those artifacts actually contain — every figure read from the
// generated data, nothing typed.
//
// How to run it yourself is the CLI guide's job; this page links there rather than repeating it.
import Layout from '../layouts/Layout.astro';
import { readFileSync, existsSync, statSync } from 'fs';
import { join } from 'path';

const root = join(process.cwd(), '..');
const rd = (p: string) => JSON.parse(readFileSync(join(process.cwd(), p), 'utf8'));

const agents = rd('src/data/agents.json');
const facts  = rd('src/data/corpus-facts.json');
const claims = rd('src/data/claims.json');

const SLUG = 'gadeke-2026-guilt-insula';
const g = agents.papers[SLUG];
const paper = claims.papers.find((p: any) => p.slug === SLUG);
const model = g.config.model_results ?? Object.values(g.models)[0];

// Artifact sizes are read from disk so a listed file that has gone missing shows as missing
// rather than as a link to a 404.
const kb = (rel: string) => {
  const p = join(root, rel);
  return existsSync(p) ? Math.max(1, Math.round(statSync(p).size / 1024)) : null;
};

const mapping = existsSync(join(root, `mappings/${SLUG}.json`))
  ? JSON.parse(readFileSync(join(root, `mappings/${SLUG}.json`), 'utf8')) : null;
const spanCount = mapping?.spans?.length ?? null;

const relCount = paper.claims.reduce((n: number, c: any) => {
  const keys = ['supports','tests','validates','confirms','extends','replicates',
                'contradicts','rules-out','dissociates-with','entails','derived-from',
                'requires','scopes','interprets','enables-method','qualifies'];
  return n + keys.reduce((m, k) => m + ((c[k] || []).length), 0);
}, 0);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ex = (f: string) => `${base}/exports/${f}`;

const STEPS = [
  {
    n: 1, cmd: `elife-extract extract \\
  --doi 10.7554/eLife.105391 \\
  --paper-slug ${SLUG} \\
  --corpus-dir ./claims \\
  --output-dir ./out`,
    title: 'Read the paper',
    what: `Fetches the article, then runs the three reader agents in parallel on different slices of it — Results text, figure captions, abstract and structure. Each returns candidate claims with the sentence it based them on. A fourth pass reconciles them into one draft.`,
    produced: `${g.drafted} drafted claims — ${Object.entries(g.per_agent_counts).map(([k, v]) => `${v} from ${k}`).join(', ')}. ${g.found_by_more} were found by more than one reader.`,
    files: [
      { label: 'draft-gadeke-2026-guilt-insula.json', rel: `extract/out/draft-${SLUG}.json`, href: null },
      { label: 'agents-gadeke-2026-guilt-insula.json', rel: `extract/out/agents-${SLUG}.json`, href: null },
    ],
    link: { label: 'Every claim and the agent that proposed it', href: `${base}/agents/` },
  },
  {
    n: 2, cmd: `elife-extract write \\
  --draft ./out/draft-${SLUG}.json \\
  --corpus-dir ./claims`,
    title: 'Write the claim tree',
    what: `Turns the draft into one Markdown file per claim, each with a UUID, a role, an assertion block naming the panel and dataset, and typed relations to other claims. This is the corpus: the files everything downstream reads.`,
    produced: `${paper.claims.length} claim files and ${relCount} typed relations.`,
    files: [],
    link: { label: `The tree for this paper`, href: `${base}/papers/${SLUG}/` },
  },
  {
    n: 3, cmd: `python3 verification/${SLUG}/verify.py`,
    title: 'Re-run the analyses',
    what: `Downloads the authors' deposited data and recomputes what the claims assert, comparing each reproduced value against the published one. Runs under observation, so every file it opens is recorded with a content hash and no status can assert more than the run produced.`,
    produced: `${facts.layers[SLUG].verified_results} claims verified against deposited data. The rest are recorded as blocked or unattempted rather than assumed.`,
    files: [
      { label: 'provenance.json — every file opened, every value computed', rel: `verification/${SLUG}/provenance.json`, href: null },
    ],
    link: { label: 'What the verification layer covers', href: `${base}/layers/` },
  },
  {
    n: 4, cmd: `elife-extract coverage --paper-slug ${SLUG}
elife-extract mark --paper-slug ${SLUG}`,
    title: 'Measure the tree against the paper',
    what: `Cuts the paper into spans and adjudicates each one against the tree — accounted for by a claim, asserting no result, or a gap. This is the only step that measures the claim tree against the paper rather than against itself.`,
    produced: spanCount ? `${spanCount} spans adjudicated, and a copy of the paper with every claim marked in place.` : 'Span adjudication and a marked copy of the paper.',
    files: [
      { label: 'gadeke-2026-guilt-insula.marked.md', rel: `marked/${SLUG}.marked.md`, href: null },
    ],
    link: null,
  },
  {
    n: 5, cmd: `python3 scripts/export_mira.py --all
python3 scripts/formats_report.py --all
python3 scripts/validate_mira.py`,
    title: 'Export and validate',
    what: `Writes the tree into each interchange format, reports what every conversion could not carry, and validates the MIRA output against the schema's own shapes pinned at a commit.`,
    produced: `${facts.mira.carried} of ${facts.mira.relations} relations carried corpus-wide, with ${facts.mira.our_violations} validation violations attributable to the encoding.`,
    files: [
      { label: `${SLUG}.mira.jsonld`, rel: `exports/${SLUG}.mira.jsonld`, href: ex(`${SLUG}.mira.jsonld`) },
      { label: `${SLUG}.oxa.json`, rel: `exports/${SLUG}.oxa.json`, href: ex(`${SLUG}.oxa.json`) },
      { label: `${SLUG}.dg.jsonld`, rel: `exports/${SLUG}.dg.jsonld`, href: ex(`${SLUG}.dg.jsonld`) },
      { label: `${SLUG}.gap-report.md`, rel: `exports/${SLUG}.gap-report.md`, href: ex(`${SLUG}.gap-report.md`) },
    ],
    link: { label: 'What each format carries', href: `${base}/formats/${SLUG}/` },
  },
];
---

<Layout title="Extract">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <header class="mb-8">
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-gray-100 tracking-tight m-0 mb-3">Extract</h1>
      <p class="text-gray-600 dark:text-gray-400 m-0 max-w-2xl leading-relaxed">
        The pipeline that produced this corpus, run end to end on the worked example. Each step
        shows the command, what it does, and the artifact it wrote &mdash; so the path from a
        published paper to a validated claim graph can be followed rather than described.
      </p>
    </header>

    <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-5 mb-10">
      <p class="text-sm text-gray-800 dark:text-gray-200 m-0 leading-relaxed">
        <strong>This is a local tool, not a hosted service.</strong> Everything below runs on
        your machine against public deposits; nothing on this page calls a backend. To run it
        yourself, start with the
        <a href={`${base}/docs/cli/install/`} class="text-amber-700 dark:text-amber-400 hover:underline">CLI guide</a>
        &mdash; it uses this same paper as its example.
      </p>
    </div>

    <!-- The paper -->
    <div class="border-l-2 border-amber-500 pl-4 mb-10">
      <p class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400 m-0 mb-1">Input</p>
      <p class="text-base text-gray-900 dark:text-gray-100 m-0 mb-1">{paper.title}</p>
      <p class="text-sm text-gray-600 dark:text-gray-400 m-0">
        {paper.authors.slice(0, 3).join(', ')}{paper.authors.length > 3 ? ' et al.' : ''} ·
        <a href={paper.url} target="_blank" class="text-amber-700 dark:text-amber-400 hover:underline">{paper.doi}</a> ·
        read from the {g.extraction_path.toUpperCase()} · model <code>{model}</code>
      </p>
    </div>

    <!-- Steps -->
    <ol class="list-none p-0 m-0 space-y-10 mb-12">
      {STEPS.map(s => (
        <li>
          <div class="flex items-baseline gap-3 mb-2">
            <span class="font-mono text-xs text-amber-700 dark:text-amber-400">{s.n}</span>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 m-0">{s.title}</h2>
          </div>

          <pre class="bg-gray-900 dark:bg-black text-gray-100 rounded-lg p-4 text-xs overflow-x-auto mb-3"><code>{s.cmd}</code></pre>

          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed m-0 mb-3">{s.what}</p>

          <div class="bg-gray-50 dark:bg-gray-800/50 rounded-lg px-4 py-3 mb-3">
            <p class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400 m-0 mb-1">Produced</p>
            <p class="text-sm text-gray-800 dark:text-gray-200 m-0">{s.produced}</p>
          </div>

          {s.files.length > 0 && (
            <ul class="list-none p-0 m-0 mb-3 space-y-1">
              {s.files.map(f => {
                const size = kb(f.rel);
                return (
                  <li class="text-xs font-mono flex flex-wrap items-baseline gap-2">
                    {size === null
                      ? <span class="text-gray-400 dark:text-gray-600">{f.label} — not present</span>
                      : f.href
                        ? <a href={f.href} target="_blank" class="text-amber-700 dark:text-amber-400 hover:underline no-underline">{f.label}</a>
                        : <span class="text-gray-700 dark:text-gray-300">{f.rel}</span>}
                    {size !== null && <span class="text-gray-400 dark:text-gray-500">{size} KB</span>}
                  </li>
                );
              })}
            </ul>
          )}

          {s.link && (
            <a href={s.link.href} class="text-sm text-amber-700 dark:text-amber-400 hover:underline no-underline">{s.link.label} &rarr;</a>
          )}
        </li>
      ))}
    </ol>

    <!-- Honest limits -->
    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">What this run does not show</h2>
    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-8">
      <p>
        <strong>No human checked any of it.</strong> The reviewer step in the pipeline is a
        second model pass, not a person. A human review step could be inserted and is not.
      </p>
      <p>
        <strong>Steps 1 and 4 need model access; the rest do not.</strong> Export, validation
        and verification run offline against committed files and public deposits, so the parts
        of this pipeline that check claims are reproducible without an API key. Extraction and
        coverage adjudication are not.
      </p>
      <p>
        <strong>This trace exists for one paper.</strong> The other {facts.papers - 1} were
        extracted before runs were saved. The corpus is there; the record of which agent
        proposed which claim is not.
      </p>
    </div>

    <footer class="pt-6 border-t border-gray-100 dark:border-gray-800 text-sm flex flex-wrap gap-x-6 gap-y-2">
      <a href={`${base}/agents/`} class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 no-underline">Agents and prompts</a>
      <a href={`${base}/docs/cli/first-paper/`} class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 no-underline">CLI guide</a>
      <a href={`${base}/papers/${SLUG}/`} class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 no-underline">The resulting claim tree</a>
    </footer>
  </div>
</Layout>
