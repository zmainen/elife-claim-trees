---
// One paper. The paper first, and the claims reached from it.
//
// This page used to open at the graph's altitude: a generated summary, a counts line, and a
// tab bar whose default view was seven collapsed sections of role vocabulary. The paper the
// claims are about was not on it. See docs/design/2026-09-11-the-reader.html — the note this
// implements — and 2026-09-11-the-paper-page.html, which sorted the tabs by category and is
// the reason the row below holds only the three things that are about us.
//
// What the reader needs is assembled in lib/reader.ts and rendered by one island. The
// masthead stays here, above the three depths, so a reader switching between them never
// loses the paper's identity.
import Layout from '../../layouts/Layout.astro';
import Reader from '../../components/Reader.tsx';
import PaperArtifacts from '../../components/PaperArtifacts.astro';
import PipelineExplorer from '../../components/PipelineExplorer';
import ClaimDAG from '../../components/ClaimDAG.tsx';
import corpus from '../../data/claims.json';
import { readerData } from '../../lib/reader';
import { fill_of } from '../../lib/pipeline';
import { paperExplorer } from '../../lib/explorer';

export function getStaticPaths() {
  return corpus.papers.map(p => ({ params: { paper: p.slug } }));
}

const { paper: paperSlug } = Astro.params;
const paperData = corpus.papers.find(p => p.slug === paperSlug)!;
const data = readerData(paperSlug!);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fill = fill_of(paperSlug!);
const stageLabel: Record<string, string> = {
  published: '', preprint: 'preprint', revision: 'under review', draft: 'draft',
};
const stage = stageLabel[(paperData as any).stage] || '';
---

<Layout title={paperData.title}>
  <div class="site-frame py-8">
    <!-- Identity. The one part that is unambiguously the paper, and the one part that does
         not change when the reader changes depth. -->
    <header class="mast">
      <p class="journal">
        {paperData.journal}{data.year && ` · ${data.year}`} · Research article
        {stage && <span class="stage"> · {stage}</span>}
      </p>
      <h1>{paperData.title}</h1>
      <p class="authors">{paperData.authors.join(', ')}</p>
      <p class="links">
        {paperData.doi && (
          <a href={`https://doi.org/${paperData.doi}`} target="_blank" rel="noopener">doi {paperData.doi}</a>
        )}
        {(paperData as any).url && (
          <a href={(paperData as any).url} target="_blank" rel="noopener">Read at {paperData.journal}</a>
        )}
        {paperData.github && (
          <a href={paperData.github} target="_blank" rel="noopener">Code and data</a>
        )}
      </p>
    </header>

    <Reader client:load data={data} base={base} />

    <!-- How this record was made, which is a question about us and comes after the paper.
         It was a row of tabs beside the paper's own views; three of the four things in that
         row were about the pipeline, and a reader who cannot yet read the paper is not helped
         by the layer map. -->
    <section class="record" id="record">
      <h2>About this record</h2>
      <p class="record-note">
        {data.counts.claims} claims, of which {data.counts.rerun} were re-run from the authors' deposited
        data. {fill.done} of {fill.total} layers have produced something; {fill.observed} of those runs were
        observed. Nobody has approved any of it —
        <a href={`${base}/pipeline/method/`}>every claim here was written by a model</a>.
      </p>

      <details class="rec">
        <summary>The claim graph <span>{data.counts.claims} claims, and what rests on what</span></summary>
        <div class="rec-body">
          <p>Solid edges are <code>requires</code>, dashed are <code>supports</code>. Clicking a node opens its card.</p>
          <div class="dag"><ClaimDAG client:visible claims={paperData.claims} paperSlug={paperSlug} /></div>
        </div>
      </details>

      <details class="rec">
        <summary>Files <span>what this paper produced, and what each format drops</span></summary>
        <div class="rec-body"><PaperArtifacts paper={paperData.slug} /></div>
      </details>

      <details class="rec">
        <summary>Pipeline <span>{fill.done}/{fill.total} layers with output · {fill.observed} observed</span></summary>
        <div class="rec-body">
          <p>
            A cell is filled when the layer produced something. <em>Run not observed</em> means the output
            is there and the run that made it was reconstructed rather than watched, so its inputs were
            never hashed and nothing can say whether it is still current.
            <a href={`${base}/pipeline/`}>All papers</a>.
          </p>
          <PipelineExplorer client:visible data={paperExplorer(paperData.slug, base)} base={base} height={480} />
        </div>
      </details>
    </section>
  </div>
</Layout>

<script is:inline>
  // The Argument view links here; a link to a closed <details> lands on nothing.
  document.addEventListener('click', e => {
    const a = e.target.closest('a[href="#record"]');
    if (!a) return;
    document.getElementById('record')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>

<style>
  .mast { padding: 0.5rem 0 0; max-width: 68ch; }
  .journal {
    font-size: 11.5px; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--card-muted); margin: 0 0 0.9rem;
  }
  .journal .stage { font-style: italic; text-transform: none; letter-spacing: 0; }
  .mast h1 {
    font-size: clamp(1.6rem, 3vw, 2.05rem); font-weight: 600; line-height: 1.18;
    letter-spacing: -0.012em; margin: 0 0 0.8rem; color: var(--card-head); text-wrap: balance;
  }
  .authors { font-size: 15px; color: var(--card-strong); margin: 0 0 0.55rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.35rem 1.15rem; font-size: 12.5px; margin: 0 0 1.5rem; }
  .links a { color: var(--card-muted); text-decoration: none; border-bottom: 1px solid var(--card-border); }
  .links a:hover { color: var(--card-head); }

  .record { margin-top: 4.5rem; border-top: 1px solid var(--card-border-hover); padding-top: 1.5rem; }
  .record h2 {
    font-size: 11.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--card-muted); margin: 0 0 0.6rem;
  }
  .record-note { font-size: 13.5px; color: var(--card-body); max-width: 62ch; margin: 0 0 1.25rem; line-height: 1.55; }
  .record-note a { color: var(--claim-strong); }

  .rec { border-top: 1px solid var(--card-border); }
  .rec:last-child { border-bottom: 1px solid var(--card-border); }
  .rec > summary {
    list-style: none; cursor: pointer; padding: 0.7rem 0; font-size: 14px; color: var(--card-head);
    display: flex; align-items: baseline; gap: 0.7rem;
  }
  .rec > summary::-webkit-details-marker { display: none; }
  .rec > summary::before {
    content: ''; width: 6px; height: 6px; flex: none;
    border-right: 1.5px solid var(--card-muted); border-bottom: 1.5px solid var(--card-muted);
    transform: rotate(-45deg); transition: transform 0.15s;
  }
  .rec[open] > summary::before { transform: rotate(45deg); }
  .rec > summary span { color: var(--card-muted); font-size: 12.5px; }
  .rec > summary:hover { color: var(--claim-strong); }
  .rec-body { padding: 0.25rem 0 1.5rem; }
  .rec-body p { font-size: 13px; color: var(--card-muted); max-width: 64ch; margin: 0 0 0.9rem; line-height: 1.55; }
  .rec-body p a { color: var(--claim-strong); }
  .dag { border: 1px solid var(--card-border); border-radius: 6px; overflow: hidden; height: 620px; }
</style>
