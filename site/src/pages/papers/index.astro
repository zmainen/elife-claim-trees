---
import Layout from '../../layouts/Layout.astro';
import { isReplicable } from '../../lib/replication';
import corpus from '../../data/claims.json';

const { papers } = corpus;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}/`;

const stageLabel: Record<string, string> = {
  published: '',
  preprint: 'preprint',
  revision: 'under review',
  draft: 'draft',
};
---

<Layout title="Papers">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-8">Papers</h1>
    <div class="space-y-3">
      {papers.map(p => {
        // Counted over the claims that have something to re-run, not over every claim: a
        // hypothesis has no number to reproduce. No badge — see the note in [paper].astro.
        const replicable = p.claims.filter((c: any) => isReplicable(c.status));
        const matched = replicable.filter((c: any) => c.status === 'verified').length;
        const stage = stageLabel[(p as any).stage] || '';
        return (
          <a href={url(`/papers/${p.slug}`)} class="flex items-start gap-4 p-4 border border-gray-200 dark:border-gray-700 rounded-xl hover:border-gray-400 hover:shadow-sm transition-all no-underline group">
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3 mb-1">
                <h2 class="text-sm font-medium text-gray-900 dark:text-gray-100 group-hover:text-blue-700 leading-snug">{p.title}</h2>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mb-2">
                {p.authors.join(', ')} · {p.journal}
                {stage && <span class="italic"> · {stage}</span>}
                {p.doi && <span> · DOI: {p.doi}</span>}
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 flex flex-wrap gap-x-3">
                <span>{p.claimCount} claims</span>
                {replicable.length > 0 && (
                  <span class="text-slate-600 dark:text-slate-400">
                    {matched} of {replicable.length} reproduced on re-run
                  </span>
                )}
                {/* The level ladder used to climb into green, which read as a grade on the
                    paper. It describes how much of the analysis we could re-run. */}
                {(p as any).verificationLevel && (p as any).verificationLevel !== 'unknown' && (
                  <span class="font-medium text-slate-500 dark:text-slate-400"
                  >{(p as any).verificationLevel}: {(p as any).verificationLabel}</span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
