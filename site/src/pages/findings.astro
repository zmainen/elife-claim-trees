---
// Retired. Cross-corpus findings are the output of a layer, so each now lives in that layer's
// section on /pipeline with the date it was found — a reader returning after a month sees what
// is new rather than a page that has quietly changed. Kept as a redirect because the old URL
// was linked; it points straight at /pipeline rather than through /layers, which is itself now
// a redirect there.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/pipeline/`, 301);
---
