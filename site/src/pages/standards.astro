---
import Layout from '../layouts/Layout.astro';
import facts from '../data/corpus-facts.json';

// Every figure in the MIRA section below is read from here, never typed. This page carried
// "57% of typed relations have no MIRA predicate" for weeks — a number about an exporter that
// emitted only supports/opposes, published as a fact about MIRA, whose relation vocabulary is
// extensible. It survived because it was a literal in the markup.
const m = facts.mira;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}/`;
---

<Layout title="Standards">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">

    <h1 class="text-3xl font-semibold text-gray-900 dark:text-gray-100 tracking-tight mb-8">A Claim node for scientific documents</h1>

    <!-- The ecosystem -->
    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-10">
      <p>
        The open scientific publishing ecosystem is converging on a shared set of standards. <a href="https://oxa.dev" class="text-amber-700 dark:text-amber-400 hover:underline" target="_blank">OXA</a> (Open Exchange Architecture) defines how to represent a scientific document — its sections, figures, math, code, and metadata — as typed JSON nodes. <a href="https://sparontologies.github.io/cito/current/cito.html" class="text-amber-700 dark:text-amber-400 hover:underline" target="_blank">CiTO</a> (Citation Typing Ontology) defines 40+ typed relationships between documents — supports, extends, disagrees with, uses method from. <a href="https://discoursegraphs.com" class="text-amber-700 dark:text-amber-400 hover:underline" target="_blank">Discourse Graphs</a> defines how to represent scientific knowledge as a graph of Questions, Claims, Evidence, and Sources.
      </p>
      <p>
        OXA is backed by Curvenote, Stencila, eLife, and others. CiTO is the standard vocabulary in the SPAR (Semantic Publishing and Referencing) ecosystem. Discourse Graphs is an active academic project with formal OWL semantics and JSON-LD exports.
      </p>
    </div>

    <!-- The gap -->
    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">The gap</h2>
    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-10">
      <p>
        None of these standards can represent the individual claims a scientific paper makes.
      </p>
      <p>
        OXA defines headings, paragraphs, images, code blocks, and citations — but not the propositions those elements are arguing for. CiTO types the relationships between <em>papers</em> — but not between the claims <em>within</em> a paper. Discourse Graphs defines Claim and Evidence nodes — but as a manual note-taking ontology, not as elements embedded in published documents.
      </p>
      <p>
        What's missing is a <strong>Claim node</strong>: a typed, addressable element within a scientific document that carries a proposition, a role in the argument (hypothesis, empirical result, prediction, control), an anchor to a specific figure panel, and typed edges to other claims.
      </p>
    </div>

    <!-- The proposal -->
    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">What we propose</h2>
    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
      <p>
        We are drafting an <a href="https://oxa.dev" class="text-amber-700 dark:text-amber-400 hover:underline" target="_blank">OXA RFC</a> to add a <code>Claim</code> node type to the specification. A Claim is a block-level OXA node — the same kind of element as a Heading or a Code block — with three additions:
      </p>
    </div>

    <div class="space-y-6 mb-10">
      <!-- Role -->
      <div class="border-l-2 border-amber-300 dark:border-amber-700 pl-4">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">A role</h3>
        <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-3">
          Nine values describing the claim's function in the paper's argument. This vocabulary extends Stencila's existing Claim types (which cover theorems and proofs) into empirical science:
        </p>
        <div class="flex flex-wrap gap-2 text-xs">
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">hypothesis</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">prediction</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">empirical</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">control</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">scope</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">methodological</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">synthesis</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">interpretation</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-gray-700 dark:text-gray-300">literature-context</span>
        </div>
      </div>

      <!-- Panel anchor -->
      <div class="border-l-2 border-amber-300 dark:border-amber-700 pl-4">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">A panel anchor</h3>
        <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
          Which figure panel(s) the claim is grounded in. Panels are the natural unit of reproducible science: one panel, one computation, one result.
        </p>
      </div>

      <!-- Typed edges -->
      <div class="border-l-2 border-amber-300 dark:border-amber-700 pl-4">
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">Typed edges to other claims</h3>
        <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-3">
          Following the same pattern OXA uses for citations (RFC0005), each edge carries a relation type from the CiTO vocabulary. Six of our {facts.relation_types_defined} relation types map directly to CiTO. The rest require extensions — defined as CiTO subproperties so that standard queries still find them:
        </p>
        <div class="grid grid-cols-2 gap-x-6 gap-y-1 text-xs text-gray-600 dark:text-gray-400">
          <div><span class="text-green-700 dark:text-green-400 font-medium">CiTO:</span> supports, extends, qualifies, disagreesWith, usesMethodIn, citesAsSourceDocument</div>
          <div><span class="text-amber-700 dark:text-amber-400 font-medium">New:</span> tests, entails, requires, scopes, interprets, rulesOut, replicates, contradicts</div>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
          The gap is telling — CiTO covers the social relations between papers but misses the logical relations within arguments. Those missing types are what makes a claim graph different from a citation graph.
        </p>
      </div>
    </div>

    <!-- Example -->
    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">What it looks like</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-3">
      A hypothesis from <a href={url('/papers/headley-2026-inhibitory-rhythms')} class="text-amber-700 dark:text-amber-400 hover:underline">Headley 2026</a>, expressed as an OXA Claim node:
    </p>
    <pre class="bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg p-4 text-xs text-gray-700 dark:text-gray-300 overflow-x-auto leading-relaxed mb-3"><code>{`{
  "type": "Claim",
  "identifier": "hypothesis-distinct-compartmental-roles",
  "role": "hypothesis",
  "children": [{
    "type": "Text",
    "value": "Perisomatic and distal dendritic inhibition serve
      distinct computational roles in regulating neuronal output."
  }],
  "relations": [
    { "xref": "prediction-distal-dendritic-spike-mechanism",
      "relationType": "claimrel:entails" },
    { "xref": "prediction-beta-optimal-distal",
      "relationType": "claimrel:entails" }
  ]
}`}</code></pre>

    <!-- The evidence -->
    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mt-10 mb-3">The evidence</h2>
    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
      <p>
        The full eLife corpus is expressed in this format: {facts.papers} papers, {facts.claims} claims, {facts.relations} typed relations, {facts.roles_used} roles and {facts.relation_types_used} of {facts.relation_types_defined} defined relation types. Also exported as <a href="https://discoursegraphs.com" class="text-amber-700 dark:text-amber-400 hover:underline" target="_blank">Discourse Graphs</a> JSON-LD and as <a href="#mira" class="text-amber-700 dark:text-amber-400 hover:underline">MIRA</a>.
      </p>
    </div>

    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">245</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">claims</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">916</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">typed relations</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">10</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">eLife papers</div>
      </div>
    </div>

    <!-- MIRA -->
    <h2 id="mira" class="text-xl font-semibold text-gray-900 dark:text-gray-100 mt-10 mb-3">MIRA, and what conversion costs</h2>
    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
      <p>
        <strong>MIRA</strong> (Modular Interoperable Research Attribution) is the discourse-graph schema eLife&rsquo;s article platform reads: Claim, Evidence, Question and Study as first-class nodes, with relations reified as nodes of their own rather than as predicates hanging off a claim.
      </p>
      <p>
        <strong>A correction, kept visible.</strong> This page previously said MIRA offers &ldquo;two predicates, <code>supports</code> and <code>opposes</code>&rdquo; and drops 57% of what a claim tree holds. That was wrong, and it was wrong in a specific and instructive way: it was a fact about <em>our exporter</em>, which at the time emitted only those two, read back as a fact about MIRA. MIRA imports a Discourse Graphs base schema in which relations are <em>definable</em> &mdash; <code>AbstractRelationDef</code> is a neutral root carrying no supporting or opposing commitment &mdash; so a relation MIRA does not name can be declared rather than dropped or flattened.
      </p>
      <p>
        The exporter now declares all of them. Of the {m.relations} typed relations in this corpus, <strong>{m.carried} are carried</strong>. Nothing is flattened: <code>tests</code>, <code>validates</code> and <code>confirms</code> keep their own types, declared under <code>mira:supports</code> so a reader who knows only core MIRA still gets the direction.
      </p>
      <p>
        Every figure below is generated by <code>scripts/corpus_facts.py</code> from the export files themselves, not typed into this page. The full account &mdash; what the schema actually requires, the two context URLs that look right and are not, how relations are reified, and what is still wrong &mdash; is in the <a href={`${base}/formats/mira/`} class="text-amber-700 dark:text-amber-400 hover:underline">MIRA working guide</a>.
      </p>
    </div>

    <div class="grid grid-cols-3 gap-4 mb-6">
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">{m.lost}</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">of {m.relations} relations genuinely lost &mdash; claims that scope the whole paper, which MIRA has no node to point at</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">{m.verification_records}</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">verification records with no MIRA node type &mdash; the one real gap</div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5">
        <div class="text-3xl font-semibold text-gray-900 dark:text-gray-100">{m.synthesised_questions}</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">Questions the export had to synthesise, each flagged as derived</div>
      </div>
    </div>

    <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
      <p>
        The deductive spine survives. <code>entails</code> is declared and emitted; <code>derived-from</code> is declared as its inverse and emitted one direction only, which is MIRA's own practice &mdash; its 942-node demo graph materialises no inverse edges either. {m.inverse_only} relations are recoverable this way rather than lost.
      </p>
      <p>
        <strong>What MIRA genuinely has no vocabulary for is verification</strong> &mdash; not what a claim rests on, which <code>observationBase</code> covers, but whether anyone recomputed the value and what came out. A search across the whole MIRA organisation returns no hits for &ldquo;verif&rdquo;, &ldquo;replicat&rdquo; or &ldquo;reproduc&rdquo; outside a licence file. That is the one gap this corpus can motivate with evidence rather than opinion, and it is offered as a proposal, not a complaint. A second, narrower gap: MIRA cannot say that a paper <em>considered and rejected</em> a proposition, so a ruled-out alternative exported as a plain <code>mira:Claim</code> reads as something the paper asserts.
      </p>
      <p>
        <strong>On validation.</strong> Against MIRA's shapes pinned at <code>{m.pinned_schema_commit?.slice(0,8)}</code>, the exports carry <strong>{m.our_violations} violations attributable to our encoding</strong>. The {m.upstream_violations} that remain are one constraint in MIRA's own generated shapes that no document can satisfy &mdash; <code>gen-shacl</code> renders two properties with an <code>sh:in</code> list of slot names alongside an <code>sh:class</code>, so the shape demands an IRI and then demands that IRI be one of two strings. A four-node file using only MIRA's own terms fails the same way. So &ldquo;validates against MIRA&rdquo; here means <em>conformant except where MIRA's own shapes reject MIRA's own terms</em> &mdash; a sentence that belongs beside any green result.
      </p>
    </div>

    <!-- Downloads -->
    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">Downloads</h2>
    <div class="space-y-3 mb-8">
      <a href={`${base}/exports/gadeke-2026-guilt-insula.oxa.json`} class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group" target="_blank">
        <code class="text-xs text-amber-700 dark:text-amber-400">JSON</code>
        <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100">G&auml;deke 2026 &mdash; OXA article JSON</span>
      </a>
      <a href={`${base}/exports/gadeke-2026-guilt-insula.dg.jsonld`} class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group" target="_blank">
        <code class="text-xs text-blue-700 dark:text-blue-400">JSONLD</code>
        <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100">G&auml;deke 2026 &mdash; Discourse Graphs JSON-LD</span>
      </a>
      <a href="/elife-claim-trees/exports/gadeke-2026-guilt-insula.mira.jsonld" class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group" target="_blank">
        <code class="text-xs text-blue-700 dark:text-blue-400">JSONLD</code>
        <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100">G&auml;deke 2026 &mdash; strict MIRA core</span>
      </a>
      <a href="/elife-claim-trees/exports/gadeke-2026-guilt-insula.mira-extended.jsonld" class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group" target="_blank">
        <code class="text-xs text-blue-700 dark:text-blue-400">JSONLD</code>
        <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100">G&auml;deke 2026 &mdash; MIRA plus what MIRA cannot carry</span>
      </a>
      <a href="/elife-claim-trees/exports/gadeke-2026-guilt-insula.gap-report.md" class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group" target="_blank">
        <code class="text-xs text-red-700 dark:text-red-400">MD</code>
        <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100">G&auml;deke 2026 &mdash; gap report: what the strict export dropped</span>
      </a>
      <a href="/elife-claim-trees/exports/claim-relations.ttl" class="flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-all no-underline group" target="_blank">
        <code class="text-xs text-green-700 dark:text-green-400">TTL</code>
        <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100">Claim-relations OWL vocabulary (8 CiTO extensions)</span>
      </a>
    </div>

  </div>
</Layout>
