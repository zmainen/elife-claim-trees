---
// The claim format — the thing the other four tabs map from.
//
// Descriptive, not argumentative: it states the schema as it stands. The proposal that a
// Claim node belongs in OXA is the section's introduction, where it is an argument rather
// than a reference entry.
import Layout from '../../layouts/Layout.astro';
import StandardsTabs from '../../components/StandardsTabs.astro';
import { byId as stdById } from '../../lib/standards';
import facts from '../../data/corpus-facts.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}/`;
const f = facts as any;
const std = stdById['ours'];
const counts: Record<string, number> = f.relation_counts;
const used = Object.entries(counts).sort((a, b) => b[1] - a[1]);
const unused = ['refutes', 'predicts', 'replicates'].filter(r => !counts[r]);
// Computed here, not inline: a generic like Record<string, number> inside JSX parses as a tag.
const reproRecords = (Object.values(f.reproduction_status) as number[]).reduce((a, b) => a + b, 0);

// Claim-type and role are different fields and the page had conflated them. claim-format.md
// §1 defines claim-type — the epistemic character of the proposition — and does not list role
// in its field table at all, though every claim file carries one. Both are shown, and the gap
// in the spec is named rather than papered over.
const CLAIM_TYPES: [string, string][] = [
  ['empirical', 'A directly observed result from data.'],
  ['interpretive', 'An inference drawn from one or more empirical claims.'],
  ['existence', 'An assertion that a phenomenon or entity exists.'],
  ['synthesis', 'A claim integrating results across papers or datasets.'],
  ['assessment', 'A methodological or quality claim.'],
];

const ROLES: [string, string][] = [
  ['hypothesis', 'A proposition the paper sets out to test.'],
  ['prediction', 'What the hypothesis entails, if it holds.'],
  ['empirical', 'A result the paper reports, anchored to a panel.'],
  ['control', 'A result whose work is to eliminate an alternative.'],
  ['scope', 'A boundary condition on where another claim holds.'],
  ['methodological', 'A capability that makes a downstream result interpretable.'],
  ['synthesis', 'A claim assembled from several others.'],
  ['interpretation', 'A reading of a result through a theoretical lens.'],
  ['literature-context', 'A claim from another paper, cited by DOI.'],
];
---

<Layout title="Ours — standards" description="The claim format: what a claim is, and what may be said about one.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <StandardsTabs current="ours" />

    <header class="mb-9 max-w-2xl">
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-gray-100 tracking-tight m-0 mb-2">The claim format</h1>
      <p class="text-gray-600 dark:text-gray-400 m-0 leading-relaxed">
        {std.blurb} A plain-text file per claim, human-readable and version-controllable, with
        the relations in its frontmatter. Everything on the other four tabs is a mapping out of
        this.
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-3 m-0">
        Full specification in <code>docs/claim-format.md</code> ·
        <a href={url('/docs/methodology/schema')} class="text-amber-700 dark:text-amber-400 no-underline hover:underline">the schema reference</a>
      </p>
    </header>

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">A claim, and what a paper does with it</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-5 max-w-2xl">
      The format's central move is that these are two things. A claim is a proposition and is
      paper-independent; an <strong>assertion</strong> is one paper instantiating it, in a
      particular panel, with a particular analysis, taking a particular stance. The same
      proposition can be asserted by two papers that disagree about it.
    </p>
    <div class="grid md:grid-cols-2 gap-5 mb-4">
      <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
        <p class="text-[10px] font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400 m-0 px-4 py-2.5 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50">
          The claim — paper-independent
        </p>
        <dl class="m-0 p-4 space-y-2.5 text-sm">
          {[
            ['uuid', 'Canonical identity, generated once and never changed. It survives renaming and migration; the slug does not.'],
            ['slug', 'The human-readable filename, 3–5 words. The working identity, and replaceable — the UUID absorbs the identity.'],
            ['doi', 'Aspirational: the state in which claims are citable units. Empty for now, and never fabricated.'],
            ['claim', 'One declarative sentence, active voice, quantitative where the result is. If it needs two sentences it is probably two claims.'],
            ['claim-type', 'The epistemic character of the proposition. Five values, below.'],
            ['role', 'What the claim does in this paper’s argument. Nine values, below.'],
            ['epistemic', 'How strongly the claim is supported across its assertions.'],
            ['concepts', 'Controlled domain terms, for retrieval.'],
            ['belongings', 'Typed edges to other claims.'],
          ].map(([k, v]) => (
            <div>
              <dt class="font-mono text-xs text-gray-900 dark:text-gray-100 inline">{k}</dt>
              <dd class="inline text-gray-600 dark:text-gray-400 m-0"> — {v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
        <p class="text-[10px] font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400 m-0 px-4 py-2.5 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50">
          An assertion — one paper, one instantiation
        </p>
        <dl class="m-0 p-4 space-y-2.5 text-sm">
          {[
            ['paper-slug', 'Which paper asserts it.'],
            ['panel', 'The figure panel, table or analysis block instantiating the claim here.'],
            ['analysis', 'The notebook or script that produces the result from data.'],
            ['dataset', 'The deposit used, with its DOI.'],
            ['method', 'The computational or experimental method.'],
            ['confidence', 'The paper’s own confidence, as distinct from ours.'],
            ['stance', 'What this paper does with the proposition: asserts, entertains, rejects, attributes.'],
          ].map(([k, v]) => (
            <div>
              <dt class="font-mono text-xs text-gray-900 dark:text-gray-100 inline">{k}</dt>
              <dd class="inline text-gray-600 dark:text-gray-400 m-0"> — {v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-10 max-w-2xl leading-relaxed">
      <strong>The panel is a property of the assertion, not of the claim.</strong> That is the
      structural shift the format rests on: <code>fig2a</code> tells you how one paper chose to
      present a proposition, and the same proposition could be asserted in another paper's
      supplementary table, or with no figure at all.
    </p>

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Reproductions</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-5 max-w-2xl">
      A third situation, beside the claim and the assertion: an agent re-enacting an assertion
      to see whether it holds. Each record says who ran it, when, against what, and what came
      out — and where it disagrees, the discrepancy is described precisely enough for the next
      person to diagnose it. &ldquo;Numbers differ&rdquo; is not sufficient.
    </p>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-10 max-w-2xl leading-relaxed">
      A reproduction record is a fact about a run, not a verdict on the claim. What the site
      shows for each one, and why it is never phrased as
      {' '}<em>verified</em>, is on any
      {' '}<a href={url('/papers')} class="text-amber-700 dark:text-amber-400 no-underline hover:underline">paper page</a>.
    </p>

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Five claim-types</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-5 max-w-2xl">
      The nature of the proposition, independent of any paper. Distinct from role, which is what
      the proposition does in one paper's argument.
    </p>
    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-2.5 mb-10">
      {CLAIM_TYPES.map(([r, d]) => (
        <div class="text-sm">
          <span class="font-mono text-xs text-amber-700 dark:text-amber-400">{r}</span>
          <span class="block text-gray-600 dark:text-gray-400 leading-snug">{d}</span>
        </div>
      ))}
    </div>

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Nine roles</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-5 max-w-2xl">
      Functional, not contentful: the same proposition can be <code>empirical</code> in one
      paper and <code>control</code> in another. The role is what the claim <em>does</em> here.
    </p>
    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-2.5 mb-10">
      {ROLES.map(([r, d]) => (
        <div class="text-sm">
          <span class="font-mono text-xs text-amber-700 dark:text-amber-400">{r}</span>
          <span class="block text-gray-600 dark:text-gray-400 leading-snug">{d}</span>
        </div>
      ))}
    </div>

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">
      Relations <span class="font-mono text-sm text-gray-400 dark:text-gray-500">{f.relation_types_used} of {f.relation_types_defined} in use</span>
    </h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-5 max-w-2xl">
      Called <strong>belongings</strong> in the specification: typed directed edges between
      claim entities, and statements about logical structure rather than citations. When a
      claim <code>requires</code> another, it asserts that its validity depends on the other's —
      so invalidity propagates, and the graph makes that auditable. Counted from the corpus,
      not declared here.
    </p>
    <div class="flex flex-wrap gap-x-5 gap-y-1.5 mb-4">
      {used.map(([r, n]) => (
        <span class="text-sm">
          <code class="text-xs text-gray-800 dark:text-gray-200">{r}</code>
          <span class="font-mono text-xs text-gray-400 dark:text-gray-500 tabular-nums ml-1">{n}</span>
        </span>
      ))}
    </div>
    {unused.length > 0 && (
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-10 max-w-2xl leading-relaxed">
        Defined and never used: {unused.map(r => <code class="text-xs">{r}</code>)}
        {' '}— which is a fact about the vocabulary worth settling rather than leaving.
        <a href="https://github.com/zmainen/elife-claim-trees/issues/20" target="_blank"
           class="text-amber-700 dark:text-amber-400 no-underline hover:underline ml-1">#20</a>
      </p>
    )}

    <div class="border-l-2 border-amber-400 dark:border-amber-600 pl-4 mb-10 max-w-2xl">
      <p class="text-sm text-gray-700 dark:text-gray-300 m-0 leading-relaxed">
        <strong>The specification is behind the corpus here.</strong>
        <code>docs/claim-format.md</code> §4 names four belongings — <code>supports</code>,
        <code>requires</code>, <code>contradicts</code>, <code>extends</code> — and the corpus
        uses {f.relation_types_used}. The others were added as the work needed them and the
        document was not brought along. The counts above are the corpus; the specification is
        the thing to fix.
      </p>
    </div>

    <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-3">What it carries that no target does</h2>
    <div class="space-y-3 text-gray-700 dark:text-gray-300 leading-relaxed mb-10 max-w-2xl">
      <p class="m-0">
        <strong>Verification.</strong> That a claim was re-run, by what code, against what
        deposited data, with what value beside the published one. This corpus holds
        {' '}{reproRecords} such records. None of the four targets has a node type for one.
      </p>
      <p class="m-0">
        <strong>Stance.</strong> That a paper <em>considered and rejected</em> a proposition.
        An alternative exported without it reads as something the paper asserts — which is the
        inversion of its meaning.
      </p>
    </div>

    <footer class="pt-6 border-t border-gray-100 dark:border-gray-800 text-sm text-gray-500 dark:text-gray-400">
      The argument for putting this in a published document is the
      {' '}<a href={url('/standards')} class="text-amber-700 dark:text-amber-400 no-underline hover:underline">section introduction</a>;
      the proposal to OXA specifically is the <a href={url('/standards/oxa')} class="text-amber-700 dark:text-amber-400 no-underline hover:underline">OXA tab</a>.
    </footer>

  </div>
</Layout>
