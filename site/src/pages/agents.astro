---
// Retired into /pipeline/induction.
//
// The roles, the prompts and the models are the general half of the induction layer, so they
// belong on that layer's page. The per-paper half — what each reader actually produced —
// belongs to the paper, and is on its cells.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/pipeline/induction/`, 301);
---
