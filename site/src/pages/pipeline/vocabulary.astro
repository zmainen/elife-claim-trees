---
// Roles and relations — what may be said about a claim, and between two of them.
//
// The reference behind the two corpus-scope layers that ask those questions. It lived under
// /docs as two Starlight pages, where it sat beside CLI documentation it had nothing to do
// with; the roles page typed its own counts and the relations page was the single page in that
// section reading generated ones. Both counts are generated here.
import Layout from '../../layouts/Layout.astro';
import { readDoc, renderMd, titleOf, bodyOf } from '../../lib/markdown';

const md = readDoc('docs/vocabulary.md');
const title = titleOf(md, 'Roles and relations');
const html = await renderMd(bodyOf(md));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={title} description="The nine roles a claim can take and the relations that can hold between two, with counts generated from the corpus.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      <a href={`${base}/pipeline/`} class="text-amber-700 dark:text-amber-400 no-underline hover:underline">Pipeline</a>
      <span class="mx-2">/</span><span class="font-mono">vocabulary</span>
      <span class="mx-2 text-gray-300 dark:text-gray-700">·</span>
      <span class="text-xs">what may be said about a claim</span>
    </nav>

    <h1 class="text-3xl font-semibold text-gray-900 dark:text-gray-100 tracking-tight m-0 mb-6">{title}</h1>
    <div class="method-prose" set:html={html} />

    <footer class="mt-12 pt-6 border-t border-gray-100 dark:border-gray-800 text-sm">
      <a href={`${base}/pipeline/`} class="text-gray-500 dark:text-gray-400 no-underline hover:text-gray-700 dark:hover:text-gray-300">← all layers</a>
    </footer>
  </div>
</Layout>
