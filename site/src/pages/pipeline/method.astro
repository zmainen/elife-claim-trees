// Moved to /method.
//
// The methodology is the longest explanatory document here and the first thing somebody
// evaluating the work asks for. Under /pipeline it sat behind a word that reads as
// machinery, reachable from one sentence and from a heading in the docs sidebar called
// "Not here". It is a destination, so it has its own address and a place in the nav.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/method/`, 301);
