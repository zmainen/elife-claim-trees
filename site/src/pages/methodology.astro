---
// Retired into /pipeline/method.
//
// The methodology is how the pipeline works, so it is depth behind the pipeline rather than a
// destination beside it: /pipeline is the graph and its state, /pipeline/method is the
// document, and each layer's own page explains that layer.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/pipeline/method/`, 301);
---
