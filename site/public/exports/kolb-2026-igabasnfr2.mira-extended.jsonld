      "@type": "mira:Evidence",
      "title": "igabasnfr2-single-exponential-kinetics",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "iGABASnFR2 and iGABASnFR2n display single-exponential stopped-flow kinetics, whereas iGABASnFR1 exhibits biphasic kinetics; the observed reaction rate constants (Kobs) are far greater for both v2 sensors than for iGABASnFR1."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.108319",
        "@type": "SourceDocument"
