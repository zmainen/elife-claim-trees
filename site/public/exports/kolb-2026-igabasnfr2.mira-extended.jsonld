      "@type": "mira:Evidence",
      "title": "igabasnfr2-retina-direction-selectivity",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "iGABASnFR2 directly demonstrates direction-selective GABA release from starburst amacrine cells in the intact retina, with significantly higher SNR and response reliability than iGABASnFR1; iGABASnFR1 signals were insufficient to detect direction selectivity even after trial-averaging."
      },
      "sourceDocument": {
