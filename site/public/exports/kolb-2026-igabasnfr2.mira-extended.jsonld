      "@type": "mira:Evidence",
      "title": "igabasnfr2-invivo-barrel-cortex",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "iGABASnFR2 detects volume-transmitted extracellular GABA signals in vivo in mouse barrel cortex (layers L2–L3, ~300 μm depth) evoked by rhythmic whisker stimulation, corresponding to a transient GABA concentration increase of approximately 2–2.5 μM at peak."
      },
      "sourceDocument": {
