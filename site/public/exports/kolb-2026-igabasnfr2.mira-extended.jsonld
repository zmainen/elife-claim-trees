    {
      "@id": "urn:uuid:81a3fe0f-a268-4abf-8ad5-b4abbdb4b2dc",
      "@type": "mira:Claim",
      "title": "igabasnfr2-cpgfp-rigid-on-gaba-binding",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "GABA binding to iGABASnFR2 closes the Venus flytrap lobes of the Pf622 domain but produces negligible conformational change in cpGFP and its flanking linkers (RMSD 0.25 Å), contrasting with the large cpGFP interface rearrangement seen in GCaMP upon calcium binding."
      },
      "haakx:epistemicStatus": "mira:Claim",
