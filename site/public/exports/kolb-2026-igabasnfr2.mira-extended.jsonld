    {
      "@id": "urn:uuid:0b8f6f71-6251-48b6-9cca-738ba83a4942#question",
      "@type": "mira:Question",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Is it the case that the fluorescence response attributed to iGABASnFR2 reflects binding of, or interference by, compounds structurally related to GABA rather than GABA itself, so the reported sensitivity is not a measure of GABA detection?"
      },
      "haak:autoDerived": true,
      "haak:reviewNote": "Derived mechanically from the hypothesis text; MIRA requires a Question node and the claim tree has none. Needs human review before publication."
    },
    {
      "@id": "urn:uuid:96510607-0b3e-42ef-8144-79bc0940eefe#question",
      "@type": "mira:Question",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Is it the case that a GABA sensor with sufficiently improved sensitivity, kinetics, and affinity will cross qualitative capability thresholds — not merely improve signal-to-noise on measurements iGABASnFR1 could already make, but enable measurements that iGABASnFR1 cannot make at all?"
      },
      "haak:autoDerived": true,
      "haak:reviewNote": "Derived mechanically from the hypothesis text; MIRA requires a Question node and the claim tree has none. Needs human review before publication."
    },
    {
      "@id": "urn:uuid:ac2b204d-13a2-4aec-91b9-4792961bc503#question",
      "@type": "mira:Question",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Is it the case that targeted near-saturation mutagenesis at sites in and around the Pf622 GABA-binding pocket and the cpGFP-linker interfaces can yield a successor to iGABASnFR1 with substantially improved sensitivity (ΔF/F), increased on-cell affinity within the physiologically relevant range, faster binding kinetics, and improved expression / membrane trafficking — without sacrificing GABA selectivity?"
      },
      "haak:autoDerived": true,
      "haak:reviewNote": "Derived mechanically from the hypothesis text; MIRA requires a Question node and the claim tree has none. Needs human review before publication."
    },
    {
      "@id": "urn:uuid:0b8f6f71-6251-48b6-9cca-738ba83a4942",
      "@type": "mira:Claim",
      "title": "alt-signal-from-cross-reactivity",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The fluorescence response attributed to iGABASnFR2 reflects binding of, or interference by, compounds structurally related to GABA rather than GABA itself, so the reported sensitivity is not a measure of GABA detection."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "hypothesis",
      "haak:stance": "rejects",
      "haak:epistemicStrength": "weak",
      "mira:addresses": {
        "@id": "urn:uuid:0b8f6f71-6251-48b6-9cca-738ba83a4942#question"
      }
    },
