    {
      "@id": "urn:uuid:c0396bdd-9084-4a13-8dd8-f616c5cdecd9",
      "@type": "mira:Protocol",
      "title": "mutagenesis-3947-variants-screened",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "High-throughput mutagenesis screening generated 3,947 total variants from 39 targeted sites; 93 variants exceeded iGABASnFR1 controls in ΔF/F, and 22 showed improvements in both sensitivity and expression."
      },
      "haakx:epistemicStatus": "mira:Claim",
