    {
      "@id": "urn:uuid:10eb034c-f5b4-422e-a43b-8375a917111d",
      "@type": "mira:Evidence",
      "title": "igabasnfr2-oncell-affinity-sevenfold",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "iGABASnFR2 expressed on the surface of cultured neurons has an on-cell EC50 of 6.4 ± 0.21 μM for GABA, representing a sevenfold higher affinity than iGABASnFR1 (EC50 ~45 μM on-cell) while remaining above the tonic extracellular GABA concentration range of 0.2–2.5 μM in the mammalian brain."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.108319",
        "@type": "SourceDocument"
      },
      "observationBase": {
