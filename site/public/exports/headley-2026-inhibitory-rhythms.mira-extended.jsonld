      "@type": "mira:Evidence",
      "title": "burst-effects-emerge-first-cycles",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Phase-dependent modulation of dendritic spike probability and action potential timing by oscillatory bursts of beta or gamma emerges within the first few cycles of the burst, indicating rapid engagement of the inhibitory control mechanism."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.95562",
        "@type": "SourceDocument"
