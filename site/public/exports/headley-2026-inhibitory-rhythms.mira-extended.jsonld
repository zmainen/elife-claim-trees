      "@type": "mira:Evidence",
      "title": "ca-spikes-couple-20ms-before-ap",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Ca²⁺ spikes in apical tuft dendrites precede somatic action potentials by approximately 20 ms in spike-triggered averages, with the strongest coupling in apical compartments distal from the soma."
      },
