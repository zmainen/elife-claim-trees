    {
      "@id": "urn:uuid:4ee66306-a11b-4333-86cf-47ea92155e76",
      "@type": "mira:Evidence",
      "title": "beta-optimal-distal-dendritic-entrainment",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "In a frequency sweep from 0.5 to 80 Hz, beta frequencies near 20 Hz produce the strongest phase-dependent entrainment of dendritic Ca²⁺ and NMDA spike onsets by distal rhythmic inhibition, as measured by Pairwise Phase Consistency."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.95562",
        "@type": "SourceDocument"
