    {
      "@id": "urn:uuid:702332b6-1ba1-40b9-9319-f9f3053d59dd",
      "@type": "mira:Evidence",
      "title": "perisomatic-inhib-subtractive-divisive",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Perisomatic inhibition reduces both the baseline firing rate (subtractive effect) and the slope of the input-output relationship (divisive effect), thereby compressing the neuron's dynamic range rather than merely shifting its operating point."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.95562",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://datadryad.org/dataset/doi:10.5061/dryad.v6wwpzhb8"
      },
      "haakx:epistemicStatus": "mira:Claim",
      "haak:role": "empirical",
      "haak:epistemicStrength": "moderate",
