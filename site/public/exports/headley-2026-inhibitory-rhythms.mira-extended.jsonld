    {
      "@id": "urn:uuid:d0c2d8d6-82ea-46a0-928f-16e6c33d36a8",
      "@type": "mira:Claim",
      "title": "prediction-beta-optimal-distal",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "If the optimal frequency of rhythmic inhibition at a compartment is set by matching the rhythm period to the local spike timescale, then distal inhibition — where apical Ca²⁺ and NMDA spikes lead the soma by ~20 ms and ~25 ms respectively — should be maximally effective at beta frequencies (~20 Hz), whose period (~50 ms) matches the dendritic-spike lead time."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:163fe42f-c4ee-480c-8f49-927d6bc22ef1"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:f924648f-6829-41cb-9722-0bd97fec6ad3",
      "@type": "mira:Claim",
      "title": "prediction-distal-dendritic-spike-mechanism",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "If perisomatic and distal dendritic inhibition serve dissociated computational roles, then doubling distal dendritic inhibition should reduce somatic firing primarily by suppressing apical Ca²⁺ and NMDA dendritic spikes, with little change in the somatic AP voltage threshold."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:eb2cf2aa-aba7-4b26-9ba2-c3589add004d"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:874d0787-6f89-43fa-aa72-d183d242fd91",
      "@type": "mira:Claim",
      "title": "prediction-gamma-optimal-perisomatic",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "If the optimal frequency of rhythmic inhibition at a compartment is set by matching the rhythm period to the local spike timescale, then perisomatic inhibition — where Na+ spikes lead the soma by 2–3 ms — should be maximally effective at gamma frequencies (40–80 Hz), whose periods are commensurate with the 2–3 ms timescale."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:163fe42f-c4ee-480c-8f49-927d6bc22ef1"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:26ddf94e-5d21-4218-8b6a-8d53e3f228cf",
      "@type": "mira:Claim",
      "title": "prediction-orthogonal-input-gating",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "If perisomatic and distal dendritic inhibition serve dissociated computational roles, then beta-frequency distal inhibition should gate clustered apical inputs phase-dependently (via dendritic spike control), gamma-frequency perisomatic inhibition should gate clustered proximal/basal inputs phase-dependently (via threshold modulation), and the two gating regimes should be largely independent of each other."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:eb2cf2aa-aba7-4b26-9ba2-c3589add004d"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:d8d26ce3-8c2d-4075-ad06-cf37c2fee73c",
      "@type": "mira:Claim",
      "title": "prediction-perisomatic-input-output-shaping",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "If perisomatic inhibition principally regulates somatic action potential generation, then it should reshape the somatic input-output curve through both subtractive (threshold shift) and divisive (gain reduction) effects, rather than producing a pure translation of the operating point."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:eb2cf2aa-aba7-4b26-9ba2-c3589add004d"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:58617715-2aaf-4762-b29d-c32aae1cdf0b",
      "@type": "mira:Claim",
      "title": "prediction-perisomatic-threshold-mechanism",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "If perisomatic and distal dendritic inhibition serve dissociated computational roles, then doubling perisomatic inhibition should reduce somatic firing primarily by raising the action potential voltage threshold, while leaving apical Ca²⁺ and NMDA dendritic spike rates largely intact."
      },
      "haakx:epistemicStatus": "mira:Hypothesis",
      "haak:role": "prediction",
      "haak:epistemicStrength": "prediction",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:eb2cf2aa-aba7-4b26-9ba2-c3589add004d"
          }
        ]
      },
      "haak:panel": "prediction"
    },
    {
      "@id": "urn:uuid:f22677a4-7db6-4fa1-80f6-1d08081293f0",
      "@type": "mira:Claim",
      "title": "pv-gamma-sst-beta-correspondence",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The model provides mechanistic grounding for the empirical association of parvalbumin-positive interneurons with gamma rhythms and somatostatin-positive interneurons with beta rhythms: PV+ neurons target perisomatic locations where gamma is optimal for AP threshold modulation, while SST+ neurons target distal dendrites where beta is optimal for dendritic spike entrainment."
      },
      "haakx:epistemicStatus": "mira:Claim",
      "haak:role": "interpretation",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "interprets": [
          {
            "@id": "urn:uuid:4ee66306-a11b-4333-86cf-47ea92155e76"
          },
          {
            "@id": "urn:uuid:568bd16c-91dc-4bf0-8841-1836968cf68e"
          },
