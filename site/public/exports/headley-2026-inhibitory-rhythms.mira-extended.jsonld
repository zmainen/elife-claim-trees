    {
      "@id": "urn:uuid:26819b09-5b20-4c90-b9f3-8bdd29a2a57c",
      "@type": "mira:Evidence",
      "title": "distal-inhib-drops-firing-02hz",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Doubling the strength of distal dendritic inhibition reduces somatic firing rate from a baseline of approximately 5.5 Hz to approximately 0.2 Hz, primarily by suppressing the occurrence of dendritic Ca²⁺ and NMDA spikes rather than by directly raising AP threshold."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.95562",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://datadryad.org/dataset/doi:10.5061/dryad.v6wwpzhb8"
      },
      "haakx:epistemicStatus": "mira:Claim",
      "haak:role": "empirical",
      "haak:epistemicStrength": "strong",
      "haak:relations": {
