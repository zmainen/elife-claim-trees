    {
      "@id": "urn:uuid:7b7dd3fd-3946-4947-9799-a4f8a8821aba",
      "@type": "mira:Evidence",
      "title": "beta-gates-distal-apical-inputs",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Beta-frequency rhythmic inhibition at distal dendritic locations gates the transmission of clustered synaptic inputs from apical dendrites to somatic output: inputs arriving during inhibitory troughs are transmitted, while inputs arriving during peaks are blocked."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.95562",
        "@type": "SourceDocument"
      },
      "observationBase": {
        "@id": "https://datadryad.org/dataset/doi:10.5061/dryad.v6wwpzhb8"
      },
