              "xref": "prediction-improved-sensor-enables-new-measurements",
              "relationType": "claimrel:entails"
            }
          ],
          "metadata": {
            "uuid": "ac2b204d-13a2-4aec-91b9-4792961bc503",
            "concepts": [
