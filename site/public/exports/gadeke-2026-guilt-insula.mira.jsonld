    {
      "@id": "haak:reldef/part_of/def",
      "@type": "RelationDef",
      "domain": "haak:type/Claim",
      "range": "haak:type/Claim",
      "subClassOf": [
        "haak:reldef/part_of",
        "dgb:RelationInstance"
      ],
      "label": "part-of",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The source claim is a component of the destination — one comparison, condition, measure or study of a proposition the destination states whole. MIRA has no predicate for composition, so like the deductive relations it hangs at AbstractRelationDef and the gap report names it."
      },
      "creator": "haak:agent/elife-claim-trees",
      "created": "2026-09-10T00:00:00.000Z",
      "modified": "2026-09-13T00:00:00.000Z"
    },
