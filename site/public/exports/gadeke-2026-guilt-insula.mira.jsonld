    },
    {
      "@id": "haak:reldef/dissociates_with/def",
      "@type": "RelationDef",
      "domain": "haak:type/Claim",
      "range": "haak:type/Claim",
      "subClassOf": [
        "haak:reldef/dissociates_with",
        "dgb:RelationInstance"
      ],
      "label": "dissociates-with",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "The source and destination jointly establish a dissociation — a contrast between two results, neither bearing on the other's truth. MIRA has no predicate for a contrast, so like the deductive relations it hangs at AbstractRelationDef and the gap report names it."
      },
      "creator": "haak:agent/elife-claim-trees",
      "created": "2026-09-10T00:00:00.000Z",
      "modified": "2026-09-13T00:00:00.000Z"
    },
