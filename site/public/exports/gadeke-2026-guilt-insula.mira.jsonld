      "@type": "RelationDef",
      "domain": "haak:type/Evidence",
      "range": "haak:type/Claim",
      "subClassOf": [
        "haak:reldef/tests",
        "dgb:RelationInstance"
      ],
      "label": "tests",
      "description": {
        "@type": "Item",
