          "haak:status": "unattempted",
          "haak:executed": false
        }
      ],
      "haak:panel": "synthesis (Discussion)"
    },
    {
      "@id": "urn:uuid:db0a9448-8fe8-4336-b220-0a71aa19d870",
      "@type": "mira:Evidence",
      "title": "unetr-outperforms-ilastik-hd95",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "UNETR ensemble segmentation shows significantly better HD95 surface distance than ilastik for both vessel and neuron channels (p<0.05 Wilcoxon signed-rank), while ilastik over-segments vessels with high recall (0.89±0.19) but low precision (0.37±0.33), evaluated on nine test images (507×507×250 µm) from six held-out mice."
      },
      "sourceDocument": {
