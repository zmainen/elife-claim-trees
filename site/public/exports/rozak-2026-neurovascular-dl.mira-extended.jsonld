    {
      "@id": "urn:uuid:a68ebd2f-95bf-43a9-b0e0-f9ce7a3fa5bd",
      "@type": "mira:Evidence",
      "title": "blue-light-dilations-exceed-green-control",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Capillary dilations following 458 nm ChR2 stimulation (0.90±0.93 µm at 1.1 mW/mm²; 0.90±0.78 µm at 4.3 mW/mm²) are significantly larger than those following 552 nm control illumination (0.58±0.92 µm; p<1e-4), confirming that the vascular responses are ChR2-mediated rather than photothermal artifacts."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.95525",
        "@type": "SourceDocument"
      },
