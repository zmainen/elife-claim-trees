    {
      "@id": "urn:uuid:8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e",
      "@type": "mira:Claim",
      "title": "synthesis-individual-vessel-measurements-insufficient",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Interrogating individual vessels in isolation is insufficient to predict how blood flow is modulated across the cerebral microvascular network. The paper's combined evidence — within-vessel radius heterogeneity (24 ± 28% along vessel length at baseline), the spatial segregation of dilations and constrictions relative to active neurons, the network-wide rise in assortativity during optogenetic stimulation, and the modulation of capillary network efficiency — together argue that point-caliber and single-vessel approaches systematically miss the coordinated, graph-level structure of functional hyperemia."
      },
      "haakx:epistemicStatus": "mira:Claim",
      "haak:role": "synthesis",
      "haak:epistemicStrength": "moderate",
      "haak:relations": {
        "derived-from": [
          {
            "@id": "urn:uuid:9a1c4f3e-5d2b-4f8a-8c71-1e6f2b9d0a77"
          }
        ]
      },
