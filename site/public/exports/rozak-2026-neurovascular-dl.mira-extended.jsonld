    {
      "@id": "urn:uuid:083ef4c3-9e93-4927-9867-3c785b2c03c0",
      "@type": "mira:Evidence",
      "title": "baseline-intra-vessel-radius-varies-24pct",
      "description": {
        "@type": "Item",
        "format": "text/plain",
        "content": "Capillary radius varies along vessel length by 24±28% of the mean resting radius across baseline frames, such that point measurements of vessel caliber cannot accurately estimate microvessel volume changes."
      },
      "sourceDocument": {
        "@id": "https://doi.org/10.7554/eLife.95525",
        "@type": "SourceDocument"
      },
